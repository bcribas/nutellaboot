# shellcheck shell=sh
# NutellaBoot 3 — bootstrap do initrd (selecionado por boot=nutellaboot).
#
# Responsabilidades, nesta ordem:
#   1. ler a configuração da partição do pendrive (label NB3CFG);
#   2. subir a rede — WIFI INCLUSIVE, com espera real de associação;
#   3. acertar o relógio (RTC errado invalida certificado);
#   4. baixar o stuff do servidor por HTTPS VERIFICADO e executá-lo.
#
# Tudo além disto vive no stuff, que é atualizado no servidor sem regravar
# pendrive. Este arquivo deve permanecer pequeno.

NB_DEFAULT_SERVER='https://nutellaboot.naquadah.com.br'
NB_CA_BUNDLE=${NB_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}
NB_RUN=${NB_RUN:-/run/nutellaboot}
# Caminhos parametrizados para que a lógica de configuração possa ser
# exercitada fora do initramfs (tests/test_bootstrap_shell.py).
NB_CFGMNT=${NB_CFGMNT:-/mnt/nb3cfg}
NB_WPA_CONF=${NB_WPA_CONF:-/etc/wpa_supplicant.conf}
NB_WPA_CTRL=${NB_WPA_CTRL:-/run/wpa_supplicant}
NB_WPA_PID=${NB_WPA_PID:-/run/initram-wpa_supplicant.pid}
NB_WPA_LOG=${NB_WPA_LOG:-/tmp/wpa_supplicant.log}
NB_SYS_NET=${NB_SYS_NET:-/sys/class/net}
# onde o dhcpcd do initramfs-tools deixa net-<iface>.conf
NB_NETCONF_DIR=${NB_NETCONF_DIR:-/run}
NB_HOSTS_FILE=${NB_HOSTS_FILE:-/etc/hosts}
NB_RESOLV_FILE=${NB_RESOLV_FILE:-/etc/resolv.conf}
NB_DEFAULTS_FILE=${NB_DEFAULTS_FILE:-/etc/nutellaboot.defaults}

# Kit de interface (cor, etapas, telas de erro). É o MESMO arquivo que o
# servidor concatena no stuff — o hook o copia para cá na hora de gerar o
# initrd. O teste é condicional de propósito: um initrd antigo, gerado antes
# do kit existir, continua bootando com as funções originais do
# initramfs-tools; perde o visual, não quebra.
# shellcheck disable=SC1091
[ -r /scripts/nb3-ui ] && . /scripts/nb3-ui

# Sem o kit, estas viram anúncios simples — o boot segue igual, só sem visual.
command -v nb_phase > /dev/null 2>&1 || nb_phase() { log_begin_msg "$*"; log_end_msg; }
command -v nb_screen > /dev/null 2>&1 || nb_screen() { for _l; do log_failure_msg "${_l#!}"; done; }
command -v nb_fatal_screen > /dev/null 2>&1 || nb_fatal_screen() {
    _t=$1
    shift
    nb_screen "$@"
    sleep "$([ "${NB_FATAL_WAIT:-30}" = 0 ] && echo 0 || echo "${NB_SCREEN_WAIT:-60}")"
    reboot -f
    panic=60 panic "$_t"
}

nb_log() { log_begin_msg "$*"; log_end_msg; }
nb_warn() { log_warning_msg "$*"; }

nb_fatal() {
    _wait=${NB_FATAL_WAIT:-30}
    log_failure_msg "$*"
    log_failure_msg "Restarting in ${_wait}s"
    sleep "$_wait"
    reboot -f
    panic=60 panic "$*"
}

# --- 1. configuração vinda do pendrive -------------------------------------

# Monta a partição de configuração (FAT, label NB3CFG) e lê os arquivos.
# Precedência: linha de comando do kernel > pendrive > padrão embutido.
# O pendrive só é necessário até aqui: o GRUB já carregou kernel e initrd na
# memória, e acabamos de copiar a configuração para a RAM. Avisar isso cedo
# importa de verdade numa sala com dezenas de máquinas — um pendrive por
# computador, e todos podem ser recolhidos enquanto o boot continua.
nb_usb_livre() {
    echo
    echo "  ┌────────────────────────────────────────────────────────────┐"
    echo "  │  PODE RETIRAR O PENDRIVE AGORA                              │"
    echo "  │  YOU CAN REMOVE THE USB DRIVE NOW                           │"
    echo "  │  YA PUEDE RETIRAR LA MEMORIA USB                            │"
    echo "  └────────────────────────────────────────────────────────────┘"
    echo
    : > /run/nutellaboot-usb-livre
    sleep 2
}

nb_conf_value() {
    # Lê KEY=valor do nutellaboot.conf, sem aspas, primeira ocorrência.
    #
    # `sed -n 1p` e não `head -n1`: o initrd não tem `head`. Enquanto tinha, o
    # pipe inteiro morria com "head: not found" e a função devolvia VAZIO para
    # TUDO — IMAGEROOT, NB_BOOT_KEY, NB_SERVER. O pendrive genérico caía na
    # tela "NO IMAGE" mesmo com o arquivo preenchido, o pendrive de sede
    # ignorava o servidor configurado e ia para o padrão embutido, e a chave de
    # boot nunca chegava ao servidor. Nada disso dava erro visível: só valores
    # vazios, em silêncio.
    # `\(set \)\{0,1\}`: o arquivo passou a usar `set CHAVE=valor`, que é o
    # que o GRUB entende — assim o MESMO arquivo diz a sede ao sistema e ao
    # menu de boot, sem um segundo arquivo para o operador copiar. O prefixo é
    # OPCIONAL para que pendrive já gravado, no formato antigo, continue
    # bootando.
    sed -n "s/^\(set \)\{0,1\}$1=//p" "$NB_RUN/nutellaboot.conf" 2> /dev/null |
        tr -d "\"'" | sed -n '1p'
}

nb_read_usbconfig() {
    mkdir -p "$NB_RUN" "$NB_CFGMNT"
    # O pendrive pode demorar a aparecer (enumeração USB) — daí as tentativas.
    _try=0
    while [ "$_try" -lt "${NB_CFG_TRIES:-5}" ]; do
        _dev=$(blkid -L NB3CFG 2> /dev/null)
        [ -n "$_dev" ] && break
        sleep "${NB_CFG_WAIT:-2}"
        _try=$((_try + 1))
    done
    if [ -n "$_dev" ] && mount -o ro "$_dev" "$NB_CFGMNT" 2> /dev/null; then
        [ -f "$NB_CFGMNT/nutellaboot.conf" ] && cp "$NB_CFGMNT/nutellaboot.conf" "$NB_RUN/"
        # a cópia na RAM já sai limpa; o arquivo do pendrive não se toca
        [ -f "$NB_CFGMNT/wifi.conf" ] &&
            nb_wifi_normalize "$NB_CFGMNT/wifi.conf" "$NB_RUN/wifi.conf"
        sync
        umount "$NB_CFGMNT"
        nb_log "configuration read from the USB drive ($_dev)"
        nb_usb_livre
    else
        nb_warn "NB3CFG partition not found - using built-in defaults"
    fi

    # shellcheck disable=SC1090
    [ -f "$NB_DEFAULTS_FILE" ] && . "$NB_DEFAULTS_FILE"

    # Precedência: linha de comando do kernel > pendrive > padrão embutido.
    [ -z "$IMAGEROOT" ] && IMAGEROOT=$(nb_conf_value IMAGEROOT)
    # Chave de boot: autentica este pendrive no servidor. Sem ela, o servidor
    # não entrega manifest nem script de boot.
    NB_BOOT_KEY=$(nb_conf_value NB_BOOT_KEY)
    _cfg_server=$(nb_conf_value NB_SERVER)
    [ -n "$_cfg_server" ] && NB_SERVER=$_cfg_server
    [ -z "$NB_SERVER" ] && NB_SERVER=$NB_DEFAULT_SERVER
    NB_SERVER=${NB_SERVER%/}

    # NB_HOSTS="nome ip" — fixa nomes no /etc/hosts sem abrir mão do TLS
    # (usado no ambiente de teste em qemu, onde o host é 10.0.2.2, e em
    # espelhos locais durante a prova).
    if [ -f "$NB_RUN/nutellaboot.conf" ]; then
        sed -n 's/^\(set \)\{0,1\}NB_HOSTS=//p' "$NB_RUN/nutellaboot.conf" | tr -d "\"'" |
            while read -r _name _ip; do
                [ -n "$_name" ] && [ -n "$_ip" ] && echo "$_ip $_name" >> "$NB_HOSTS_FILE"
            done
    fi
    [ -z "$IMAGEROOT" ] && nb_fatal_screen "NO IMAGE" \
        "!This USB drive does not say which image to boot." \
        "" \
        "The file nutellaboot.conf on the USB drive must contain a line" \
        "with the name of the image for this site, for example:" \
        "" \
        "    IMAGEROOT=26spsp" \
        "" \
        "!What to do:" \
        "  1. Plug the USB drive into any computer (it is a normal FAT" \
        "     partition, readable on Windows, macOS and Linux)" \
        "  2. Open nutellaboot.conf in a text editor" \
        "  3. Set IMAGEROOT to the name your site was given" \
        "" \
        "The same USB drive works for every site - only this file changes."
    nb_log "image=$IMAGEROOT server=$NB_SERVER"
}

# --- 2. rede ----------------------------------------------------------------

# Tira espaços das pontas de um campo. Sem `local` em sh POSIX, e por isso o
# prefixo próprio: `_iface` compartilhado entre duas funções desta seção já
# custou uma sala (a mesma classe do `sleep RAM` do 05-ui.sh).
nb_trim() {
    _nbt_v=$1
    while :; do
        case "$_nbt_v" in
            ' '* ) _nbt_v=${_nbt_v# } ;;
            *' ' ) _nbt_v=${_nbt_v% } ;;
            *) break ;;
        esac
    done
    printf '%s' "$_nbt_v"
}

# Deixa o wifi.conf num formato só: sem CR, sem BOM, campos separados por UM
# tab e sem espaço nas pontas.
#
# A limpeza é feita UMA VEZ, aqui, sobre a cópia que vai para a RAM — e não em
# cada consumidor. São dois (o wpa_supplicant deste script e os perfis do
# NetworkManager em 60-postmount.d/80-nm-wifi.sh) e duas limpezas seriam duas
# verdades sobre o mesmo arquivo, que é como uma delas fica para trás.
#
# O arquivo é digitado à mão pela sede, no computador que ela tiver: chega com
# CRLF do Windows (o `\r` gruda na senha e o handshake falha com a senha certa
# na tela), com BOM, e com espaço sobrando depois do último campo. Nada disso
# dá erro — dá "não associou".
nb_wifi_normalize() {
    [ -s "$1" ] || return 1
    _nbz_tmp=$2.raw
    tr -d '\r' < "$1" | sed "1s/^$(printf '\357\273\277')//" > "$_nbz_tmp"
    : > "$2"
    _nbz_num=0
    while IFS= read -r _nbz_line || [ -n "$_nbz_line" ]; do
        _nbz_num=$((_nbz_num + 1))
        # comentário indentado continua sendo comentário; linha de rede
        # indentada continua sendo rede
        case "$(nb_trim "$_nbz_line")" in '' | '#'*) continue ;; esac
        # Sem TAB não dá para adivinhar onde acaba o nome: "minha rede" é um
        # SSID legítimo, e cortar no espaço quebraria quem está certo. Avisa —
        # e o relatório de falha mostra o nome que foi tentado, o que torna o
        # engano óbvio para quem está na sala.
        case "$_nbz_line" in
            *"$(printf '\t')"*) ;;
            *)
                nb_warn "wifi.conf line $_nbz_num: no TAB between network name and password"
                ;;
        esac
        # `read` num bloco depois do pipe, e não num heredoc: heredoc sem aspas
        # trata `\` como escape, e senha com barra invertida sairia diferente
        # do que a sede digitou.
        printf '%s\n' "$_nbz_line" | {
            IFS="$(printf '\t')" read -r _nbz_ssid _nbz_psk _nbz_flags
            _nbz_ssid=$(nb_trim "$_nbz_ssid")
            _nbz_psk=$(nb_trim "$_nbz_psk")
            _nbz_flags=$(nb_trim "$_nbz_flags")
            [ -n "$_nbz_ssid" ] &&
                printf '%s\t%s\t%s\n' "$_nbz_ssid" "$_nbz_psk" "$_nbz_flags"
        } >> "$2"
    done < "$_nbz_tmp"
    rm -f "$_nbz_tmp"
    return 0
}

# Escapa o que quebraria o arquivo do wpa_supplicant. Senha com aspas existe.
nb_wpa_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Gera wpa_supplicant.conf a partir do wifi.conf já normalizado.
#
# `nb_write_wpaconf basico` escreve o key_mgmt mínimo. O padrão declara também
# WPA-PSK-SHA256 e SAE, com `ieee80211w=1`: roteador atual costuma vir em modo
# WPA2/WPA3 misto, que exige proteção de quadro de gerência, e o cliente que só
# oferece WPA-PSK **associa e é desconectado por ele mesmo** um segundo depois
# — foi exatamente o que a sala viu no console ("deauthenticating by local
# choice" logo após "associated", nas duas bandas do mesmo roteador).
#
# O `ieee80211w=1` é opcional, não obrigatório: AP velho sem PMF continua
# conectando. E um wpa_supplicant compilado sem SAE rejeita o ARQUIVO INTEIRO,
# não só a linha — é por isso que existe o modo básico, para o qual o
# configure_wifi regrava e tenta de novo.
nb_write_wpaconf() {
    [ -s "$NB_RUN/wifi.conf" ] || return 1
    _nbc_km="WPA-PSK WPA-PSK-SHA256 SAE"
    _nbc_pmf=1
    if [ "$1" = basico ]; then
        _nbc_km="WPA-PSK"
        _nbc_pmf=""
    fi
    {
        echo "ctrl_interface=$NB_WPA_CTRL"
        echo "update_config=0"
        while IFS="$(printf '\t')" read -r _nbc_ssid _nbc_psk _nbc_flags; do
            case "$_nbc_ssid" in '' | '#'*) continue ;; esac
            # 64 caracteres hexadecimais são a chave já derivada (PMK), e vão
            # SEM aspas. Fora disso, a senha tem que ter de 8 a 63: o
            # wpa_supplicant descarta o bloco EM SILÊNCIO, e o sintoma vira
            # "não associou" — sem nada dizendo que o tamanho é o problema.
            _nbc_raw=""
            if [ ${#_nbc_psk} -eq 64 ]; then
                case "$_nbc_psk" in
                    *[!0-9a-fA-F]*) ;;
                    *) _nbc_raw=1 ;;
                esac
            fi
            if [ -n "$_nbc_psk" ] && [ -z "$_nbc_raw" ] &&
                { [ ${#_nbc_psk} -lt 8 ] || [ ${#_nbc_psk} -gt 63 ]; }; then
                # >&2 porque o bloco inteiro tem a saída redirecionada para o
                # arquivo gerado: sem isso o aviso vira uma linha de
                # configuração inválida dentro do wpa_supplicant.conf
                nb_warn "wifi.conf: password for $_nbc_ssid has ${#_nbc_psk} characters (WPA needs 8 to 63)" >&2
                continue
            fi
            echo "network={"
            echo "	ssid=\"$(nb_wpa_escape "$_nbc_ssid")\""
            case "$_nbc_flags" in *hidden*) echo "	scan_ssid=1" ;; esac
            if [ -n "$_nbc_psk" ]; then
                if [ -n "$_nbc_raw" ]; then
                    echo "	psk=$_nbc_psk"
                else
                    echo "	psk=\"$(nb_wpa_escape "$_nbc_psk")\""
                fi
                echo "	key_mgmt=$_nbc_km"
                [ -n "$_nbc_pmf" ] && echo "	ieee80211w=1"
            else
                echo "	key_mgmt=NONE"
            fi
            echo "}"
        done < "$NB_RUN/wifi.conf"
    } > "$NB_WPA_CONF"
    return 0
}

# A interface sem fio, por CAPACIDADE e não por nome. `ip -o link | /: w/`
# pegava qualquer nome começando com w — um `wwan0` de modem 4G ganha da
# `wlan0` na ordem do kernel, e o boot ia tentar associar num modem.
nb_wifi_iface() {
    for _nbi_d in "$NB_SYS_NET"/*; do
        [ -e "$_nbi_d/wireless" ] || [ -e "$_nbi_d/phy80211" ] || continue
        echo "${_nbi_d##*/}"
        return 0
    done
    return 1
}

# `wpa_cli` pelo PATH (que o /init do initramfs-tools define com /sbin e
# /usr/sbin), e não por caminho absoluto: com o caminho fixo nenhum teste
# alcança esta parte, e foi assim que o módulo do NetworkManager passou meses
# sem nunca ter sido executado.
nb_wpa_cli() {
    wpa_cli -p"$NB_WPA_CTRL" -i"$NB_WIFI_IFACE" "$@" 2> /dev/null
}

# Por que o wifi não subiu — a pergunta que o console não respondia.
#
# O log do wpa_supplicant vai para um arquivo (-f) e morre com o initrd, então
# "associated" seguido de "deauthenticating by local choice" era tudo que a
# sala via, e isso não distingue senha errada de PMF exigido pelo AP. Aqui as
# linhas que importam vão para a tela. A SENHA NUNCA É IMPRESSA.
nb_wifi_state() {
    NB_WIFI_STATE=$(nb_wpa_cli status | sed -n 's/^wpa_state=//p' | sed -n 1p)
    [ -z "$NB_WIFI_STATE" ] && NB_WIFI_STATE="(no answer from wpa_supplicant)"
}

nb_wifi_report() {
    nb_wifi_state
    # -i: o supplicant escreve "Management frame protection" com maiúscula, e
    # casar caixa exata é como um diagnóstico deixa de aparecer sem ninguém ver.
    # "failed to set" pega o "Failed to set PTK to the driver" — a linha que
    # denuncia a chave que o KERNEL recusou (crypto faltando), e que o filtro
    # antigo jogava fora: sem ela, três rodadas de campo apontaram para senha.
    _nbr_log=$(grep -iE '4-way|pre-shared|wrong_key|assoc-reject|mfp|management frame|rsn: |no suitable network|failed to set|^line [0-9]+:' \
        "$NB_WPA_LOG" 2> /dev/null | tail -n 6)

    nb_warn "wifi state: $NB_WIFI_STATE"
    [ -n "$_nbr_log" ] && echo "$_nbr_log"

    # O TAMANHO e a IMPRESSÃO DIGITAL da senha, nunca a senha. O tamanho
    # denuncia caractere a mais; o md5 curto fecha a questão dos BYTES de vez:
    # quem está na sala roda `printf '%s' 'senha' | md5sum` em qualquer Linux
    # e compara os 8 primeiros dígitos. Iguais e o AP recusando = a senha que
    # chegou é a que se queria, e o problema é adiante (driver, firmware, AP).
    # 8 hex de um md5 não ajudam a quebrar nada.
    while IFS="$(printf '\t')" read -r _nbr_s _nbr_p _nbr_f; do
        [ -n "$_nbr_s" ] || continue
        _nbr_fp=$(printf '%s' "$_nbr_p" | md5sum | cut -c1-8)
        nb_warn "wifi.conf asks for '$_nbr_s' (password: ${#_nbr_p} chars, fingerprint $_nbr_fp)"
    done < "$NB_RUN/wifi.conf"

    # qual rádio e qual firmware — cada foto de falha passa a dizer o hardware
    dmesg 2> /dev/null | grep -iE 'mt79|mt76|iwlwifi|ath[0-9]+k|rtw8|brcmfmac|wifi.*firmware' |
        tail -n 3

    # o scan responde a pergunta seguinte sem nenhuma ferramenta extra: o nome
    # aparece? com que segurança? ([WPA2-PSK-CCMP], [WPA3-SAE], [MFPR])
    _nbr_ssids=$(cut -f1 "$NB_RUN/wifi.conf" 2> /dev/null | tr '\n' ' ')
    for _nbr_s in $_nbr_ssids; do
        _nbr_seen=$(nb_wpa_cli scan_results | grep -F "	$_nbr_s" | tail -n 1)
        [ -n "$_nbr_seen" ] && nb_warn "seen: $_nbr_seen"
    done

    _nbr_min=$(printf '%s' "$_nbr_log" | tr 'A-Z' 'a-z')
    # A falta de crypto no kernel VENCE o caso de senha: os dois produzem
    # WRONG_KEY no log, e mandar a sede trocar uma senha certa foi exatamente
    # o beco das três primeiras rodadas.
    if [ -n "$NB_WIFI_CRYPTO_MISSING" ]; then
        NB_WIFI_REASON="this initrd is missing kernel crypto for WPA (rebuild it with nb3-build-initrd)"
        return 0
    fi
    case "$_nbr_min" in
        *"failed to set"*)
            NB_WIFI_REASON="the kernel refused to install the session key (missing crypto modules in the initrd?)" ;;
        *pre-shared* | *4-way* | *wrong_key*)
            NB_WIFI_REASON="the access point refused the password in wifi.conf" ;;
        *mfp* | *"management frame"*)
            NB_WIFI_REASON="the access point requires WPA3 protection (PMF)" ;;
        *"no suitable network"*)
            NB_WIFI_REASON="the network name in wifi.conf was not found on the air" ;;
        *"line "*)
            NB_WIFI_REASON="this wpa_supplicant does not understand the generated config" ;;
        *)
            NB_WIFI_REASON="associated but the key exchange did not finish (state: $NB_WIFI_STATE)" ;;
    esac
}

# Espera a associação completar. Devolve 0 no COMPLETED, 1 no estouro.
nb_wifi_wait() {
    _nbw_n=0
    while [ "$_nbw_n" -lt "${NB_WIFI_TIMEOUT:-30}" ]; do
        if nb_wpa_cli status | grep -q '^wpa_state=COMPLETED'; then
            return 0
        fi
        sleep 1
        _nbw_n=$((_nbw_n + 1))
    done
    return 1
}

# Power-save DESLIGADO antes de conectar. Não é otimização: a família MediaTek
# mt792x (mt7921/mt7922/mt7925) tem histórico documentado de firmware cochilando
# no meio do 4-way handshake — o AP recusa/reenvia, o cliente desiste, e o
# supplicant carimba WRONG_KEY com a senha CERTA, em qualquer rede. Foi
# exatamente o visto numa MT7922 de sala: WRONG_KEY em duas redes WPA2, uma
# delas um hotspot lançado só para o teste. Upstream chegou a desligar o
# power-save por padrão no mt7921. Para os demais chips é inócuo.
nb_wifi_power_off() {
    iw dev "$NB_WIFI_IFACE" set power_save off 2> /dev/null
    # runtime-PM do dispositivo, sem depender de ferramenta nenhuma
    [ -w "$NB_SYS_NET/$NB_WIFI_IFACE/device/power/control" ] &&
        echo on > "$NB_SYS_NET/$NB_WIFI_IFACE/device/power/control" 2> /dev/null
    return 0
}

# nbwifidebug=y na linha de comando do kernel: supplicant em -dd e, na falha,
# o fim do log no console. Para a sessão de depuração na máquina física,
# editando a linha do GRUB — sem regravar nada.
nb_wifi_debug() {
    grep -q 'nbwifidebug=y' "${NB_CMDLINE:-/proc/cmdline}" 2> /dev/null
}

# Os templates de crypto do 4-way, ANTES de conectar. O mac80211 pede
# ccm(aes) por request_module na hora de instalar a chave — se o módulo não
# está no initrd, a chave não instala, o supplicant desiste e o log diz
# WRONG_KEY com a senha CERTA, em qualquer chip. Rede aberta funcionando com
# WPA falhando é a assinatura. modprobe é no-op quando é builtin.
#
# A falha aqui NÃO bloqueia a tentativa: driver full-MAC (brcmfmac) faz a
# crypto por conta própria e conecta mesmo sem os templates.
nb_wifi_crypto_check() {
    modprobe cmac 2> /dev/null
    modprobe michael_mic 2> /dev/null
    if ! modprobe ccm 2> /dev/null; then
        nb_warn "this initrd was built without the WPA crypto modules (ccm); rebuild it with nb3-build-initrd"
        NB_WIFI_CRYPTO_MISSING=1
    fi
    return 0
}

# Sobe o wifi e ESPERA a associação completar. O nb2 dava um `sleep 3` cego —
# tempo insuficiente para handshake WPA2 + DHCP, e o stuff servido ainda por
# cima deixava de chamar esta função.
configure_wifi() {
    NB_WIFI_IFACE=$(nb_wifi_iface) || return 1
    [ -z "$NB_WIFI_IFACE" ] && return 1
    nb_write_wpaconf "$1" || [ -s "$NB_WPA_CONF" ] || return 1

    log_begin_msg "Connecting to wifi on $NB_WIFI_IFACE"
    rfkill unblock all 2> /dev/null
    ip link set "$NB_WIFI_IFACE" up
    nb_wifi_power_off
    nb_wifi_crypto_check
    mkdir -p "$NB_WPA_CTRL"

    # Um supplicant por interface. A partir da segunda rodada de
    # configure_localnetwork o antigo ainda está vivo, e dois processos
    # disputando o mesmo rádio dão associação e queda em laço.
    if nb_wifi_supplicant_vivo; then
        nb_wpa_cli reconfigure > /dev/null
        nb_wpa_cli reassociate > /dev/null
    else
        _nbw_dbg=""
        nb_wifi_debug && _nbw_dbg="-dd"
        # shellcheck disable=SC2086
        if ! wpa_supplicant -i"$NB_WIFI_IFACE" -c"$NB_WPA_CONF" \
            -P"$NB_WPA_PID" -B -f "$NB_WPA_LOG" $_nbw_dbg; then
            # Não subiu: quase sempre é o arquivo que ele não entendeu (um
            # key_mgmt que este binário não tem compilado invalida o arquivo
            # INTEIRO). Uma tentativa com o mínimo, e só uma.
            if [ "$1" != basico ]; then
                nb_warn "wpa_supplicant refused the config; retrying without WPA3"
                configure_wifi basico
                return $?
            fi
            log_failure_msg "wpa_supplicant did not start"
            return 1
        fi
    fi

    if ! nb_wifi_wait && [ "$1" != basico ]; then
        # Subiu mas o handshake não fechou. Antes de desistir, o mesmo
        # supplicant tenta com o bloco mínimo (só WPA-PSK, sem PMF): há driver
        # e AP que tropeçam nos AKMs extras ou no bit de proteção de quadro, e
        # a diferença entre os dois modos é ela mesma um diagnóstico — o
        # relatório diz em qual deles conectou ou falhou.
        nb_warn "handshake did not finish with the WPA3-capable config; retrying with plain WPA2"
        nb_write_wpaconf basico
        nb_wpa_cli reconfigure > /dev/null
        nb_wpa_cli reassociate > /dev/null
        set -- basico
        nb_wifi_wait
    fi
    if nb_wpa_cli status | grep -q '^wpa_state=COMPLETED'; then
        log_end_msg
        nb_log "wifi associated on $NB_WIFI_IFACE (${1:-full} config)"
        DEVICE=$NB_WIFI_IFACE
        export DEVICE
        return 0
    fi

    log_failure_msg "wifi did not associate within ${NB_WIFI_TIMEOUT:-30}s"
    nb_wifi_report
    if nb_wifi_debug; then
        nb_warn "nbwifidebug: last lines of the wpa_supplicant log"
        tail -n 40 "$NB_WPA_LOG" 2> /dev/null
    fi
    return 1
}

nb_wifi_supplicant_vivo() {
    _nbv_pid=$(sed -n 1p "$NB_WPA_PID" 2> /dev/null)
    [ -n "$_nbv_pid" ] && [ -d "/proc/$_nbv_pid" ]
}

nb_resolvconf() {
    for _f in "$NB_NETCONF_DIR"/net-*.conf; do
        [ -e "$_f" ] || continue
        # shellcheck disable=SC1090
        . "$_f"
    done
    : > "$NB_RESOLV_FILE"
    for _d in $IPV4DNS0 $IPV4DNS1; do
        [ -n "$_d" ] && [ "$_d" != 0.0.0.0 ] &&
            echo "nameserver $_d" >> "$NB_RESOLV_FILE"
    done
}

nb_online() {
    _out=$(wget.good -q -O - --timeout=10 --tries=1 \
        --ca-certificate="$NB_CA_BUNDLE" "$NB_SERVER/boot/v3/sanity" 2> /dev/null)
    echo "$_out" | grep -q penguin
}

# nb_post <caminho> <destino> — busca um recurso do servidor enviando a chave
# de boot por POST (com TLS verificado). Devolve 1 se falhar.
nb_post() {
    wget.good -q -O "$2" --timeout=20 --tries=2 \
        --ca-certificate="$NB_CA_BUNDLE" \
        --post-data="key=$NB_BOOT_KEY" \
        "$NB_SERVER/boot/v3/$1"
}

# A sala tentou por wifi e não foi. Dizer "confira o cabo e o switch" aqui é
# mandar procurar no lugar errado — e o motivo já foi apurado pelo
# nb_wifi_report, que leu o log do wpa_supplicant e o resultado do scan.
nb_wifi_screen() {
    nb_fatal_screen "NO WIFI" \
        "!This machine could not connect to the wireless network." \
        "" \
        "Reason: $NB_WIFI_REASON" \
        "Last state: ${NB_WIFI_STATE:-unknown}" \
        "" \
        "The system is downloaded over the network at every boot, so the" \
        "machine cannot continue without it." \
        "" \
        "!What to check, in this order:" \
        "  1. wifi.conf on the USB drive: the network name and the" \
        "     password, with a TAB between them (not spaces)." \
        "     Upper and lower case matter in both." \
        "  2. Is the same network working on a phone, in this room?" \
        "  3. If the access point uses WPA3 or requires PMF, try the" \
        "     WPA2 network of the same router, or add a WPA2 network." \
        "  4. A network cable also solves it: plug it in and reboot."
}

# Devolve o `configure_networking` do initramfs-tools ao estado de quem ainda
# não configurou nada.
#
# Ele roda NESTA shell e marca `IP="done"` assim que existe um
# /run/net-*.conf. Na chamada seguinte — a do wifi — o `case ${IP}` dele cai em
# `none|done|off` e NÃO RODA DHCP NENHUM. Basta a porta cabeada pegar um lease
# que não alcança o servidor (switch sem uplink, VLAN errada, portal cativo)
# para o wifi ficar sem IP para sempre, sem nada na tela dizendo isso.
#
# Restaura, e não zera: um `ip=` estático na linha de comando do kernel
# continua valendo. E os net-*.conf velhos saem porque o DNS e o gateway da
# tentativa que falhou seriam lidos como se fossem desta.
nb_net_reset() {
    IP=$_nbn_ip0
    IP6=$_nbn_ip60
    rm -f "$NB_NETCONF_DIR"/net-*.conf "$NB_NETCONF_DIR"/net6-*.conf 2> /dev/null
}

# Existe cabo? Só quem responde 0 explicitamente é considerado sem link: NIC
# que não reporta carrier fica no caminho cabeado, que é o que boota as salas.
nb_wired_carrier() {
    for _nbk_d in "$NB_SYS_NET"/*; do
        _nbk_i=${_nbk_d##*/}
        [ "$_nbk_i" = lo ] && continue
        if [ -e "$_nbk_d/wireless" ] || [ -e "$_nbk_d/phy80211" ]; then
            continue
        fi
        ip link set "$_nbk_i" up 2> /dev/null
        _nbk_c=$(cat "$_nbk_d/carrier" 2> /dev/null)
        [ "$_nbk_c" = 0 ] || return 0
    done
    return 1
}

configure_localnetwork() {
    _nbn_ip0=$IP
    _nbn_ip60=$IP6
    _nbn_try=1
    while [ "$_nbn_try" -le "${NB_NET_TRIES:-10}" ]; do
        # Sem cabo, o dhcpcd cabeado gasta 30+60+90+120 s ANTES de o wifi ser
        # tentado — cinco minutos por rodada, medidos no console de uma sala.
        # Com wifi.conf preenchido e nenhum carrier, o rádio vem primeiro.
        if [ -s "$NB_RUN/wifi.conf" ] && ! nb_wired_carrier; then
            nb_warn "no cable detected; trying wifi first"
        else
            log_begin_msg "Configuring the network (attempt $_nbn_try)"
            nb_net_reset
            configure_networking
            nb_resolvconf
            log_end_msg
            nb_online && return 0
            nb_warn "no connection over the wired network; trying wifi"
        fi

        if configure_wifi; then
            nb_net_reset
            configure_networking
            nb_resolvconf
            nb_online && return 0
            # associou e o DHCP não veio: outro problema, outra ação — e o
            # estado do rádio ainda é o que a tela precisa mostrar
            nb_wifi_state
            NB_WIFI_REASON="wifi is connected but no address came from DHCP"
        fi
        sleep 5
        _nbn_try=$((_nbn_try + 1))
    done
    # A falha do rádio tem tela própria: a lista de "confira o cabo e o switch"
    # não serve para quem está tentando por wifi, e o motivo já é conhecido.
    [ -n "$NB_WIFI_REASON" ] && nb_wifi_screen
    nb_fatal_screen "NO NETWORK" \
        "!This machine could not reach the network." \
        "" \
        "Server: $NB_SERVER" \
        "" \
        "The system is downloaded over the network at every boot, so the" \
        "machine cannot continue without it." \
        "" \
        "!What to check, in this order:" \
        "  1. Is the network cable plugged in at both ends?" \
        "     Look for the link light on the network port." \
        "  2. Are the other machines in this room booting normally?" \
        "     If they are, the problem is this machine's cable or port." \
        "     If none of them boot, the problem is the room's switch" \
        "     or the internet link." \
        "  3. Using wifi? Check that wifi.conf on the USB drive has the" \
        "     right network name and password (case matters)." \
        "  4. Is DHCP working in this room?"
}

# --- 3. relógio -------------------------------------------------------------

# Certificado TLS é validado contra a data do sistema; máquina com RTC zerado
# ou fora de hora falharia a verificação. O /time é HTTP simples de propósito:
# ele existe justamente para tornar o HTTPS possível.
nb_synctime() {
    _epoch=$(wget.good -q -O - --timeout=10 --tries=2 --no-check-certificate \
        "$NB_SERVER/boot/v3/time" 2>/dev/null | tr -dc '0-9')
    [ -z "$_epoch" ] && return 1
    _now=$(date +%s)
    _diff=$((_epoch - _now))
    [ "$_diff" -lt 0 ] && _diff=$((-_diff))
    if [ "$_diff" -gt 60 ]; then
        date -s "@$_epoch" > /dev/null 2>&1
        nb_log "clock corrected (was off by ${_diff}s)"
    fi
}

# --- 4. stuff ---------------------------------------------------------------

nb_fetch_stuff() {
    _n=1
    while [ "$_n" -le 10 ]; do
        if nb_post "$IMAGEROOT/stuff" /stuff.sh && [ -s /stuff.sh ]; then
            return 0
        fi
        nb_warn "could not download the boot script (attempt $_n/10)"
        sleep 5
        _n=$((_n + 1))
    done
    return 1
}

# A rede subiu mas o servidor nao respondeu: e um problema diferente de "sem
# rede", e a acao de quem esta na sala tambem e diferente.
nb_no_server_screen() {
    nb_fatal_screen "NO SERVER" \
        "!The network works, but the NutellaBoot server did not answer." \
        "" \
        "Server: $NB_SERVER" \
        "Image:  $IMAGEROOT" \
        "Reason: $1" \
        "" \
        "!What to check:" \
        "  1. Is the server name above the right one for this site?" \
        "     It is set by NB_SERVER in nutellaboot.conf on the USB drive." \
        "  2. Can this room reach the internet at all?" \
        "     A captive portal (hotel/campus login page) also causes this." \
        "  3. If the clock of this machine is very wrong, the secure" \
        "     connection is refused. Check the date in the BIOS setup;" \
        "     a dead CMOS battery gives exactly this symptom." \
        "  4. Ask whoever runs the server whether it is up."
}

mountroot() {
    nb_phase "NUTELLABOOT - reading the configuration from the USB drive"
    nb_read_usbconfig

    nb_phase "NETWORK - connecting to the network"
    configure_localnetwork
    nb_synctime
    nb_online || nb_no_server_screen "the server answered before, but not after the clock was corrected"

    nb_fetch_stuff || nb_no_server_screen "the boot script could not be downloaded"
    log_begin_msg "Running the boot script from the server"
    # Identidade deste initrd, carimbada por tools/nb3-build-initrd. Um initrd
    # anterior a esta mudança não tem o arquivo: a variável fica VAZIA e o
    # stuff não confere nada — um pendrive já gravado não tem como saber a
    # própria versão, e recusá-lo seria recusar todos de uma vez.
    NB_INITRD_BUILD=$(sed -n 1p /etc/nutellaboot-build 2> /dev/null)
    export NB_SERVER NB_CA_BUNDLE IMAGEROOT NB_INITRD_BUILD
    # shellcheck disable=SC1091
    . /stuff.sh
    log_end_msg

    nb3_mountroot
}

mount_top() { local_top; }
mount_premount() { local_premount; }
mount_bottom() { local_bottom; }
