# shellcheck shell=sh
# NutellaBoot 3 — bootstrap do initrd (selecionado por boot=nutellaboot).
#
# Responsabilidades, nesta ordem:
#   1. ler a configuração da partição do pendrive (label NB3CFG);
#   2. subir a rede — WIFI INCLUSIVE, com espera real de associação;
#   3. acertar o relógio (RTC errado invalida certificado);
#   4. baixar o stuff do servidor por HTTPS VERIFICADO e executá-lo.
#
# Tudo além disto vive no stuff, que é atualizado no servidor sem regravar
# pendrive. Este arquivo deve permanecer pequeno.

NB_DEFAULT_SERVER='https://nutellaboot.naquadah.com.br'
NB_CA_BUNDLE=${NB_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}
NB_RUN=${NB_RUN:-/run/nutellaboot}
# Caminhos parametrizados para que a lógica de configuração possa ser
# exercitada fora do initramfs (tests/test_bootstrap_shell.py).
NB_CFGMNT=${NB_CFGMNT:-/mnt/nb3cfg}
NB_WPA_CONF=${NB_WPA_CONF:-/etc/wpa_supplicant.conf}
NB_HOSTS_FILE=${NB_HOSTS_FILE:-/etc/hosts}
NB_RESOLV_FILE=${NB_RESOLV_FILE:-/etc/resolv.conf}
NB_DEFAULTS_FILE=${NB_DEFAULTS_FILE:-/etc/nutellaboot.defaults}

# Kit de interface (cor, etapas, telas de erro). É o MESMO arquivo que o
# servidor concatena no stuff — o hook o copia para cá na hora de gerar o
# initrd. O teste é condicional de propósito: um initrd antigo, gerado antes
# do kit existir, continua bootando com as funções originais do
# initramfs-tools; perde o visual, não quebra.
# shellcheck disable=SC1091
[ -r /scripts/nb3-ui ] && . /scripts/nb3-ui

# Sem o kit, estas viram anúncios simples — o boot segue igual, só sem visual.
command -v nb_phase > /dev/null 2>&1 || nb_phase() { log_begin_msg "$*"; log_end_msg; }
command -v nb_screen > /dev/null 2>&1 || nb_screen() { for _l; do log_failure_msg "${_l#!}"; done; }
command -v nb_fatal_screen > /dev/null 2>&1 || nb_fatal_screen() {
    _t=$1
    shift
    nb_screen "$@"
    sleep "$([ "${NB_FATAL_WAIT:-30}" = 0 ] && echo 0 || echo "${NB_SCREEN_WAIT:-60}")"
    reboot -f
    panic=60 panic "$_t"
}

nb_log() { log_begin_msg "$*"; log_end_msg; }
nb_warn() { log_warning_msg "$*"; }

nb_fatal() {
    _wait=${NB_FATAL_WAIT:-30}
    log_failure_msg "$*"
    log_failure_msg "Restarting in ${_wait}s"
    sleep "$_wait"
    reboot -f
    panic=60 panic "$*"
}

# --- 1. configuração vinda do pendrive -------------------------------------

# Monta a partição de configuração (FAT, label NB3CFG) e lê os arquivos.
# Precedência: linha de comando do kernel > pendrive > padrão embutido.
# O pendrive só é necessário até aqui: o GRUB já carregou kernel e initrd na
# memória, e acabamos de copiar a configuração para a RAM. Avisar isso cedo
# importa de verdade numa sala com dezenas de máquinas — um pendrive por
# computador, e todos podem ser recolhidos enquanto o boot continua.
nb_usb_livre() {
    echo
    echo "  ┌────────────────────────────────────────────────────────────┐"
    echo "  │  PODE RETIRAR O PENDRIVE AGORA                              │"
    echo "  │  YOU CAN REMOVE THE USB DRIVE NOW                           │"
    echo "  │  YA PUEDE RETIRAR LA MEMORIA USB                            │"
    echo "  └────────────────────────────────────────────────────────────┘"
    echo
    : > /run/nutellaboot-usb-livre
    sleep 2
}

nb_conf_value() {
    # Lê KEY=valor do nutellaboot.conf, sem aspas, primeira ocorrência.
    #
    # `sed -n 1p` e não `head -n1`: o initrd não tem `head`. Enquanto tinha, o
    # pipe inteiro morria com "head: not found" e a função devolvia VAZIO para
    # TUDO — IMAGEROOT, NB_BOOT_KEY, NB_SERVER. O pendrive genérico caía na
    # tela "NO IMAGE" mesmo com o arquivo preenchido, o pendrive de sede
    # ignorava o servidor configurado e ia para o padrão embutido, e a chave de
    # boot nunca chegava ao servidor. Nada disso dava erro visível: só valores
    # vazios, em silêncio.
    sed -n "s/^$1=//p" "$NB_RUN/nutellaboot.conf" 2> /dev/null |
        tr -d "\"'" | sed -n '1p'
}

nb_read_usbconfig() {
    mkdir -p "$NB_RUN" "$NB_CFGMNT"
    # O pendrive pode demorar a aparecer (enumeração USB) — daí as tentativas.
    _try=0
    while [ "$_try" -lt "${NB_CFG_TRIES:-5}" ]; do
        _dev=$(blkid -L NB3CFG 2> /dev/null)
        [ -n "$_dev" ] && break
        sleep "${NB_CFG_WAIT:-2}"
        _try=$((_try + 1))
    done
    if [ -n "$_dev" ] && mount -o ro "$_dev" "$NB_CFGMNT" 2> /dev/null; then
        [ -f "$NB_CFGMNT/nutellaboot.conf" ] && cp "$NB_CFGMNT/nutellaboot.conf" "$NB_RUN/"
        [ -f "$NB_CFGMNT/wifi.conf" ] && cp "$NB_CFGMNT/wifi.conf" "$NB_RUN/"
        sync
        umount "$NB_CFGMNT"
        nb_log "configuration read from the USB drive ($_dev)"
        nb_usb_livre
    else
        nb_warn "NB3CFG partition not found - using built-in defaults"
    fi

    # shellcheck disable=SC1090
    [ -f "$NB_DEFAULTS_FILE" ] && . "$NB_DEFAULTS_FILE"

    # Precedência: linha de comando do kernel > pendrive > padrão embutido.
    [ -z "$IMAGEROOT" ] && IMAGEROOT=$(nb_conf_value IMAGEROOT)
    # Chave de boot: autentica este pendrive no servidor. Sem ela, o servidor
    # não entrega manifest nem script de boot.
    NB_BOOT_KEY=$(nb_conf_value NB_BOOT_KEY)
    _cfg_server=$(nb_conf_value NB_SERVER)
    [ -n "$_cfg_server" ] && NB_SERVER=$_cfg_server
    [ -z "$NB_SERVER" ] && NB_SERVER=$NB_DEFAULT_SERVER
    NB_SERVER=${NB_SERVER%/}

    # NB_HOSTS="nome ip" — fixa nomes no /etc/hosts sem abrir mão do TLS
    # (usado no ambiente de teste em qemu, onde o host é 10.0.2.2, e em
    # espelhos locais durante a prova).
    if [ -f "$NB_RUN/nutellaboot.conf" ]; then
        sed -n 's/^NB_HOSTS=//p' "$NB_RUN/nutellaboot.conf" | tr -d "\"'" |
            while read -r _name _ip; do
                [ -n "$_name" ] && [ -n "$_ip" ] && echo "$_ip $_name" >> "$NB_HOSTS_FILE"
            done
    fi
    [ -z "$IMAGEROOT" ] && nb_fatal_screen "NO IMAGE" \
        "!This USB drive does not say which image to boot." \
        "" \
        "The file nutellaboot.conf on the USB drive must contain a line" \
        "with the name of the image for this site, for example:" \
        "" \
        "    IMAGEROOT=26spsp" \
        "" \
        "!What to do:" \
        "  1. Plug the USB drive into any computer (it is a normal FAT" \
        "     partition, readable on Windows, macOS and Linux)" \
        "  2. Open nutellaboot.conf in a text editor" \
        "  3. Set IMAGEROOT to the name your site was given" \
        "" \
        "The same USB drive works for every site - only this file changes."
    nb_log "image=$IMAGEROOT server=$NB_SERVER"
}

# --- 2. rede ----------------------------------------------------------------

# Gera wpa_supplicant.conf a partir do wifi.conf do pendrive (ssid<TAB>psk[<TAB>hidden]).
nb_write_wpaconf() {
    [ -s "$NB_RUN/wifi.conf" ] || return 1
    {
        echo "ctrl_interface=/run/wpa_supplicant"
        echo "update_config=0"
        while IFS="$(printf '\t')" read -r _ssid _psk _flags; do
            case "$_ssid" in '' | '#'*) continue ;; esac
            echo "network={"
            echo "	ssid=\"$_ssid\""
            case "$_flags" in *hidden*) echo "	scan_ssid=1" ;; esac
            if [ -n "$_psk" ]; then
                echo "	psk=\"$_psk\""
                echo "	key_mgmt=WPA-PSK"
            else
                echo "	key_mgmt=NONE"
            fi
            echo "}"
        done < "$NB_RUN/wifi.conf"
    } > "$NB_WPA_CONF"
    return 0
}

# Sobe o wifi e ESPERA a associação completar. O nb2 dava um `sleep 3` cego —
# tempo insuficiente para handshake WPA2 + DHCP, e o stuff servido ainda por
# cima deixava de chamar esta função.
configure_wifi() {
    # sem `head` no initrd: o awk já resolve, e um pipe a menos
    _iface=$(ip -o link | awk -F': ' '/: w/ {print $2; exit}')
    [ -z "$_iface" ] && return 1
    nb_write_wpaconf || [ -s /etc/wpa_supplicant.conf ] || return 1

    log_begin_msg "Connecting to wifi on $_iface"
    rfkill unblock all 2>/dev/null
    ip link set "$_iface" up
    mkdir -p /run/wpa_supplicant
    /sbin/wpa_supplicant -i"$_iface" -c/etc/wpa_supplicant.conf \
        -P/run/initram-wpa_supplicant.pid -B -f /tmp/wpa_supplicant.log

    _n=0
    while [ "$_n" -lt "${NB_WIFI_TIMEOUT:-30}" ]; do
        if /sbin/wpa_cli -p/run/wpa_supplicant -i"$_iface" status 2>/dev/null |
            grep -q '^wpa_state=COMPLETED'; then
            log_end_msg
            nb_log "wifi associated on $_iface"
            DEVICE=$_iface
            export DEVICE
            return 0
        fi
        sleep 1
        _n=$((_n + 1))
    done
    log_failure_msg "wifi did not associate within ${NB_WIFI_TIMEOUT:-30}s"
    return 1
}

nb_resolvconf() {
    for _f in /run/net-*.conf; do
        [ -e "$_f" ] || continue
        # shellcheck disable=SC1090
        . "$_f"
    done
    : > "$NB_RESOLV_FILE"
    for _d in $IPV4DNS0 $IPV4DNS1; do
        [ -n "$_d" ] && [ "$_d" != 0.0.0.0 ] &&
            echo "nameserver $_d" >> "$NB_RESOLV_FILE"
    done
}

nb_online() {
    _out=$(wget.good -q -O - --timeout=10 --tries=1 \
        --ca-certificate="$NB_CA_BUNDLE" "$NB_SERVER/boot/v3/sanity" 2> /dev/null)
    echo "$_out" | grep -q penguin
}

# nb_post <caminho> <destino> — busca um recurso do servidor enviando a chave
# de boot por POST (com TLS verificado). Devolve 1 se falhar.
nb_post() {
    wget.good -q -O "$2" --timeout=20 --tries=2 \
        --ca-certificate="$NB_CA_BUNDLE" \
        --post-data="key=$NB_BOOT_KEY" \
        "$NB_SERVER/boot/v3/$1"
}

configure_localnetwork() {
    _n=1
    while [ "$_n" -le "${NB_NET_TRIES:-10}" ]; do
        log_begin_msg "Configuring the network (attempt $_n)"
        configure_networking
        nb_resolvconf
        log_end_msg
        nb_online && return 0

        nb_warn "no connection over the wired network; trying wifi"
        if configure_wifi; then
            configure_networking
            nb_resolvconf
            nb_online && return 0
        fi
        sleep 5
        _n=$((_n + 1))
    done
    nb_fatal_screen "NO NETWORK" \
        "!This machine could not reach the network." \
        "" \
        "Server: $NB_SERVER" \
        "" \
        "The system is downloaded over the network at every boot, so the" \
        "machine cannot continue without it." \
        "" \
        "!What to check, in this order:" \
        "  1. Is the network cable plugged in at both ends?" \
        "     Look for the link light on the network port." \
        "  2. Are the other machines in this room booting normally?" \
        "     If they are, the problem is this machine's cable or port." \
        "     If none of them boot, the problem is the room's switch" \
        "     or the internet link." \
        "  3. Using wifi? Check that wifi.conf on the USB drive has the" \
        "     right network name and password (case matters)." \
        "  4. Is DHCP working in this room?"
}

# --- 3. relógio -------------------------------------------------------------

# Certificado TLS é validado contra a data do sistema; máquina com RTC zerado
# ou fora de hora falharia a verificação. O /time é HTTP simples de propósito:
# ele existe justamente para tornar o HTTPS possível.
nb_synctime() {
    _epoch=$(wget.good -q -O - --timeout=10 --tries=2 --no-check-certificate \
        "$NB_SERVER/boot/v3/time" 2>/dev/null | tr -dc '0-9')
    [ -z "$_epoch" ] && return 1
    _now=$(date +%s)
    _diff=$((_epoch - _now))
    [ "$_diff" -lt 0 ] && _diff=$((-_diff))
    if [ "$_diff" -gt 60 ]; then
        date -s "@$_epoch" > /dev/null 2>&1
        nb_log "clock corrected (was off by ${_diff}s)"
    fi
}

# --- 4. stuff ---------------------------------------------------------------

nb_fetch_stuff() {
    _n=1
    while [ "$_n" -le 10 ]; do
        if nb_post "$IMAGEROOT/stuff" /stuff.sh && [ -s /stuff.sh ]; then
            return 0
        fi
        nb_warn "could not download the boot script (attempt $_n/10)"
        sleep 5
        _n=$((_n + 1))
    done
    return 1
}

# A rede subiu mas o servidor nao respondeu: e um problema diferente de "sem
# rede", e a acao de quem esta na sala tambem e diferente.
nb_no_server_screen() {
    nb_fatal_screen "NO SERVER" \
        "!The network works, but the NutellaBoot server did not answer." \
        "" \
        "Server: $NB_SERVER" \
        "Image:  $IMAGEROOT" \
        "Reason: $1" \
        "" \
        "!What to check:" \
        "  1. Is the server name above the right one for this site?" \
        "     It is set by NB_SERVER in nutellaboot.conf on the USB drive." \
        "  2. Can this room reach the internet at all?" \
        "     A captive portal (hotel/campus login page) also causes this." \
        "  3. If the clock of this machine is very wrong, the secure" \
        "     connection is refused. Check the date in the BIOS setup;" \
        "     a dead CMOS battery gives exactly this symptom." \
        "  4. Ask whoever runs the server whether it is up."
}

mountroot() {
    nb_phase "NUTELLABOOT - reading the configuration from the USB drive"
    nb_read_usbconfig

    nb_phase "NETWORK - connecting to the network"
    configure_localnetwork
    nb_synctime
    nb_online || nb_no_server_screen "the server answered before, but not after the clock was corrected"

    nb_fetch_stuff || nb_no_server_screen "the boot script could not be downloaded"
    log_begin_msg "Running the boot script from the server"
    export NB_SERVER NB_CA_BUNDLE IMAGEROOT
    # shellcheck disable=SC1091
    . /stuff.sh
    log_end_msg

    nb3_mountroot
}

mount_top() { local_top; }
mount_premount() { local_premount; }
mount_bottom() { local_bottom; }
