#!/bin/sh
# Hook único do NutellaBoot 3: rede, wifi, downloads, overlay e seeding.
# (No nb2 isto era dividido entre hooks/network e hooks/overlay, com metade
# das linhas comentadas.)

set -e

PREREQ=""
prereqs() { echo "${PREREQ}"; }
case "${1}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# --- drivers e módulos ---
copy_modules_dir kernel/drivers/net
manual_add_modules overlay squashfs loop ext4 nvme sd_mod ahci fuse
for mod in virtio virtio_net virtio_blk virtio_pci; do
    manual_add_modules $mod
done

# --- downloads ---
# wget do busybox é limitado (sem --ca-certificate); usamos o wget real,
# renomeado para não colidir.
copy_exec /usr/bin/wget /usr/bin/wget.good
copy_exec /usr/bin/aria2c /usr/bin
copy_exec /usr/bin/md5sum /usr/bin
copy_exec /bin/bash /bin
# `head` não vem no initramfs deste ambiente, e a falta dele não dá erro
# visível: o pipe morre com "head: not found" e a variável fica vazia. Foi
# assim que TODO valor lido do pendrive (IMAGEROOT, NB_BOOT_KEY, NB_SERVER)
# voltava em branco. Os scripts deixaram de usá-lo; ele vem junto para que a
# próxima linha que o use não repita a história.
copy_exec /usr/bin/head /usr/bin
# `tail` pela mesma razão: o diagnóstico de wifi mostra as últimas linhas do
# log do wpa_supplicant. Ele HOJE aparece no initrd sem ninguém pedir, e é
# exatamente esse tipo de sorte que some numa versão nova do initramfs-tools.
copy_exec /usr/bin/tail /usr/bin
# `stat` é o tamanho do arquivo para a barra de progresso do download
copy_exec /usr/bin/stat /usr/bin
# `stdbuf` desliga a bufferização da saída do aria2. Sem ele, os números do
# progresso ficam presos no buffer de 4 kB do libc e chegam TODOS DE UMA VEZ
# no fim: a barra fica parada o download inteiro e pula para 100% (medido —
# num download de 10 s, todas as amostras com o mesmo carimbo de tempo).
#
# Ele funciona por LD_PRELOAD e procura a biblioteca por um caminho ABSOLUTO
# compilado dentro dele (dá para ver com `strings`). Sem ela, sai 125 sem nem
# executar o comando.
#
# O DESTINO VAI COM O CAMINHO COMPLETO, e o diretório é criado antes. Com
# `copy_exec ORIGEM DIRETÓRIO`, o initramfs-tools só acrescenta o nome do
# arquivo quando o diretório JÁ EXISTE no initrd em construção; como
# /usr/libexec/coreutils não existia, a biblioteca foi gravada COMO o arquivo
# /usr/libexec/coreutils. O stdbuf achou arquivo onde esperava diretório e
# nenhuma máquina baixou mais nada — com a mensagem comida pelo filtro do awk.
_nb_lsb=
for _c in /usr/libexec/coreutils/libstdbuf.so /usr/lib/*/coreutils/libstdbuf.so; do
    if [ -f "$_c" ]; then
        _nb_lsb=$_c
        break
    fi
done
if [ -n "$_nb_lsb" ]; then
    copy_exec /usr/bin/stdbuf /usr/bin/stdbuf
    mkdir -p "$DESTDIR${_nb_lsb%/*}"
    copy_exec "$_nb_lsb" "$_nb_lsb"
fi

# --- TLS DE VERDADE ---
# O nb2 embutia um único certificado no stuff e depois desligava a verificação
# em todo download (--check-certificate=false). Aqui vai o bundle completo do
# sistema e a verificação fica ligada.
copy_file config /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# --- wifi ---
copy_exec /sbin/wpa_supplicant /sbin
copy_exec /sbin/wpa_cli /sbin
copy_exec /usr/bin/wpa_passphrase /bin
copy_exec /sbin/rfkill /sbin
# `iw` não é usado por script nenhum — o wpa_cli responde tudo que o boot
# precisa. Vai junto porque, quando o wifi de uma sede não sobe, é a única
# forma de olhar o rádio pelo console: `iw dev wlan0 scan`, `iw reg get`.
# Condicional porque nem toda imagem-mestre o tem instalado, e a falta dele
# não pode derrubar a construção do initrd.
for _nb_iw in /usr/sbin/iw /sbin/iw /usr/bin/iw; do
    if [ -x "$_nb_iw" ]; then
        copy_exec "$_nb_iw" /usr/sbin/iw
        break
    fi
done

# --- identidade da construção ---
# Carimbada por tools/nb3-build-initrd logo antes do update-initramfs. É o que
# permite à máquina, já rodando, saber se o pendrive de onde ela bootou está
# em dia com este servidor.
if [ -f /etc/initramfs-tools/nb3-build-id ]; then
    copy_file config /etc/initramfs-tools/nb3-build-id /etc/nutellaboot-build
fi

# --- padrões do servidor (sobrescritos pelo pendrive/cmdline) ---
if [ -f /etc/initramfs-tools/nutellaboot.defaults ]; then
    copy_file config /etc/initramfs-tools/nutellaboot.defaults /etc/nutellaboot.defaults
fi

# --- armazenamento ---
copy_exec /sbin/losetup /sbin
copy_exec /bin/fallocate /bin
copy_exec /sbin/mkfs.ext4 /sbin
copy_exec /sbin/mke2fs /sbin/mke2fs.good
copy_exec /sbin/blkid /sbin

# --- seeding ---
copy_exec /usr/bin/webfsd /usr/bin

# --- interface de tela ---
# O mesmo 05-ui.sh que o servidor concatena no stuff. Copiar (em vez de
# duplicar o código aqui) é o que garante que as telas do initrd e as do stuff
# sejam idênticas: uma fonte só. O bootstrap carrega este arquivo se ele
# existir, então um initrd antigo continua bootando sem ele.
for _ui in /etc/initramfs-tools/nb3-ui /usr/share/nutellaboot3/05-ui.sh; do
    if [ -f "$_ui" ]; then
        copy_file script "$_ui" /scripts/nb3-ui
        break
    fi
done

exit 0
