#!/usr/bin/env gjs
// Tela de bloqueio do NutellaBoot 3.
//
// Diferenças em relação à versão do nb2:
//  - o tema é LOCAL (/usr/share/maratona-lock/themes/<tema>), não uma página
//    remota; a tela funciona mesmo sem rede, e não há mais o prefixo de sede
//    "25brbr-" fixo no código de todo mundo;
//  - os dados do time são cacheados em disco no momento do bloqueio;
//  - a própria tela consulta o servidor e se fecha quando o bloqueio sai;
//  - existe uma senha local de emergência (definida no configureitor), útil
//    quando a rede cai no meio da prova.
//
// A tela roda como icpc e NÃO lê /etc/.nb3 — não pode: o arquivo é 0600 root
// e guarda a chave de máquina. Foi exatamente esse desenho que quebrou a
// senha de emergência: a tela tentava ler o hash de lá, o readFile devolvia
// null em silêncio, e NENHUMA senha destravava. Agora tudo que a tela precisa
// vem por argumento (e a chave de boot por ambiente), e a senha digitada vai
// para o FIFO do agente — quem confere o hash é ele, como root.

imports.gi.versions.Gtk = "3.0";
imports.gi.versions.WebKit2 = "4.1";

const { Gtk, Gdk, GLib, Gio } = imports.gi;
let WebKit = null;
try {
    WebKit = imports.gi.WebKit2;
} catch (e) {
    imports.gi.versions.WebKit2 = "4.0";
    try {
        WebKit = imports.gi.WebKit2;
    } catch (e2) {
        WebKit = null;
    }
}

const THEME_DIR = "/usr/share/maratona-lock/themes";
const POLL_SECONDS = 4;

// --image X --server Y ... vindos do agente, que é quem sabe (ele lê o
// /etc/.nb3 como root)
function parseArgs(argv) {
    const out = {};
    for (let i = 0; i < argv.length - 1; i++) {
        if (argv[i].startsWith("--")) out[argv[i].slice(2)] = argv[i + 1];
    }
    return out;
}

const args = parseArgs(ARGV);
const theme = args.theme || "classico";
const lang = args.lang || "pt";
const base = args.server || "";
const image = args.image || "";
const fifo = args.fifo || "/run/nb3-unlock.fifo";
const bootKey = GLib.getenv("NB_BOOT_KEY") || "";

// o cache vai onde o icpc PODE escrever — /home/.nb3 é do root, e a escrita
// falhava em silêncio dentro de um try vazio
const CACHE = GLib.build_filenamev([
    GLib.get_user_runtime_dir() || "/tmp",
    "nb3-lockinfo.json",
]);

function readFile(path) {
    try {
        const [ok, bytes] = GLib.file_get_contents(path);
        return ok ? new TextDecoder().decode(bytes) : null;
    } catch (e) {
        return null;
    }
}

function machineMac() {
    // o agente sabe a chave e a passa; sem ela, o MAC estável que o initrd
    // gravou (a mesma chave do agente); o BOOTIF só de reserva — sem ele
    // (boot por wifi) a tela nem consultava o estado de bloqueio
    if (args.mac) return args.mac;
    const estavel = (readFile("/etc/mac-icpc") || "").trim();
    if (/^[0-9a-f]{2}(-[0-9a-f]{2}){5,7}$/.test(estavel)) return estavel;
    const cmdline = readFile("/proc/cmdline") || "";
    const m = cmdline.match(/BOOTIF=01-([0-9a-f-]+)/);
    return m ? m[1] : "";
}

// A senha digitada vai INTEIRA para o agente pelo FIFO, via stdin de um cat —
// nunca por argumento, que apareceria no ps. A tela não sabe se acertou: quem
// fecha a janela, no acerto, é o agente (pkill), como sempre foi.
function sendPassword(typed) {
    try {
        const proc = Gio.Subprocess.new(
            ["sh", "-c", `cat > '${fifo.replace(/'/g, "'\\''")}'`],
            Gio.SubprocessFlags.STDIN_PIPE
        );
        proc.communicate_utf8_async(typed + "\n", null, () => {});
    } catch (e) {
        log("maratona-lock: falha ao enviar a senha: " + e);
    }
}

function fetchText(url, onDone) {
    // A chave de boot vai no cabeçalho: os endpoints de boot são
    // autenticados (no nb2 qualquer um que soubesse o nome da sede lia tudo).
    const argv = ["curl", "--silent", "--max-time", "8"];
    if (bootKey) {
        argv.push("-H", "X-NB-Boot-Key: " + bootKey);
    }
    argv.push(url);
    const proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE);
    proc.communicate_utf8_async(null, null, (p, res) => {
        try {
            const [, out] = p.communicate_utf8_finish(res);
            onDone(out);
        } catch (e) {
            onDone(null);
        }
    });
}

const mac = machineMac();

// Dados do time: busca do servidor e guarda em cache; se não houver rede,
// usa o cache do bloqueio anterior.
function loadLockInfo(onDone) {
    if (!base || !image || !mac) {
        onDone(JSON.parse(readFile(CACHE) || "{}"));
        return;
    }
    fetchText(`${base}/boot/v3/${image}/lockinfo/${mac}`, (text) => {
        if (text && text.trim().startsWith("{")) {
            try {
                GLib.file_set_contents(CACHE, text);
            } catch (e) {}
            onDone(JSON.parse(text));
        } else {
            onDone(JSON.parse(readFile(CACHE) || "{}"));
        }
    });
}

const app = new Gtk.Application({ application_id: "br.com.naquadah.MaratonaLock" });

app.connect("activate", () => {
    loadLockInfo((info) => {
        const display = Gdk.Display.get_default();
        const nMonitors = display ? display.get_n_monitors() : 1;

        // A senha é digitada às cegas (a tela não mostra campo de texto por
        // padrão; o tema pode desenhar um indicador).
        let buffer = "";
        function handleKey(event) {
            const [, keyval] = event.get_keyval();
            if (keyval === Gdk.KEY_Return || keyval === Gdk.KEY_KP_Enter) {
                if (buffer) sendPassword(buffer);
                buffer = "";
            } else if (keyval === Gdk.KEY_BackSpace) {
                buffer = buffer.slice(0, -1);
            } else if (keyval >= Gdk.KEY_KP_0 && keyval <= Gdk.KEY_KP_9) {
                // dígito do teclado numérico: keyval_to_unicode devolve 0 para
                // eles, e a senha digitada no numpad perdia todos os dígitos
                buffer += String(keyval - Gdk.KEY_KP_0);
            } else {
                const code = Gdk.keyval_to_unicode(keyval);
                // 0 = tecla sem mapa (Shift, setas, teclas mortas): ignora.
                // (comparação numérica de propósito — a versão anterior tinha
                // um byte NUL literal dentro de uma string, que qualquer
                // normalização de texto transformava em outro caractere)
                if (code > 0) buffer += String.fromCharCode(code);
            }
            if (buffer.length > 128) buffer = "";
        }

        // Uma janela por monitor: no nb2 a tela cobria só a tela principal.
        for (let i = 0; i < nMonitors; i++) {
            const win = new Gtk.ApplicationWindow({ application: app });
            win.set_decorated(false);
            win.set_keep_above(true);
            win.stick();
            win.fullscreen_on_monitor(display.get_default_screen(), i);

            if (WebKit) {
                const view = new WebKit.WebView();
                // O tema é carregado de file://; liberar acesso entre arquivos
                // locais evita que o logotipo/CSS sejam bloqueados por CORS.
                try {
                    const st = view.get_settings();
                    st.set_allow_file_access_from_file_urls(true);
                    st.set_enable_write_console_messages_to_stdout(true);
                } catch (e) {}
                const payload = encodeURIComponent(JSON.stringify(info));
                const url =
                    `file://${THEME_DIR}/${theme}/index.html` +
                    `?lang=${lang}&info=${payload}` +
                    (i === 0 ? "&primary=1" : "");
                view.load_uri(url);
                win.add(view);
            } else {
                // Sem WebKit ainda dá para bloquear: rótulo simples.
                const label = new Gtk.Label({
                    label: "AGUARDE — NÃO MEXA NO MOUSE NEM NO TECLADO",
                });
                win.add(label);
            }
            win.show_all();

            // TODAS as janelas escutam o teclado: só a do monitor 0 escutava,
            // e bastava o foco cair na outra para a senha ir para o nada
            win.connect("key-press-event", (w, event) => {
                handleKey(event);
                return true;
            });
        }

        // Consulta o servidor: quando o bloqueio sai, a tela se fecha sozinha
        // (não depende do agente estar vivo).
        if (base && image && mac) {
            GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, POLL_SECONDS, () => {
                fetchText(`${base}/boot/v3/${image}/machines/${mac}/lockstate`, (text) => {
                    if (text && text.trim() === "unlocked") app.quit();
                });
                return GLib.SOURCE_CONTINUE;
            });
        }
    });
});

app.run([]);
