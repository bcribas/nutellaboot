#!/usr/bin/env python3
"""Extrator mínimo de JSON para o agente shell.

O agente é shell (decisão do projeto), mas montar e ler JSON com awk/sed é
como o nb2 fazia — inclusive com o truque de anexar uma máquina fictícia para
consertar a vírgula final. A imagem já tem python3; usá-lo aqui custa nada e
elimina uma classe inteira de erros.

Uso:
    ... | nb3-json commands     -> uma linha "id<TAB>comando<TAB>args" por comando
    ... | nb3-json locked       -> "true" ou "false"
    nb3-json --escape k v k v   -> {"k": "v", ...} com escape correto
"""

import json
import sys


def main() -> int:
    what = sys.argv[1] if len(sys.argv) > 1 else ""

    # Montar JSON no shell com aspas é como o nb2 fazia, e o nome de um
    # dispositivo USB vem do fabricante: basta uma aspa no modelo para o corpo
    # sair quebrado e o alerta se perder.
    if what == "--escape":
        pares = sys.argv[2:]
        print(json.dumps(dict(zip(pares[::2], pares[1::2])), ensure_ascii=False))
        return 0

    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 1

    if what == "commands":
        for cmd in data.get("commands", []):
            print(f"{cmd.get('id', '')}\t{cmd.get('command', '')}\t{cmd.get('args', '')}")
    elif what == "locked":
        print("true" if (data.get("lock") or {}).get("locked") else "false")
    else:
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
