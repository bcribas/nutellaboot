#!/bin/bash
# nb3-genusb — gera a imagem do pendrive de boot SEM root.
#
# O gerador do nb2 exigia losetup + mount + grub-install (e carregava um
# binário do GRUB do Debian junto com uma libdevmapper para funcionar num
# host Fedora). Aqui tudo é feito manipulando o ARQUIVO de imagem:
#   sfdisk grava a tabela de partição no arquivo;
#   mformat/mcopy (mtools) formatam e populam a FAT usando offset (img@@1M);
#   grub2-mkstandalone/grub2-mkimage (ou grub-*, no Debian) produzem os
#   bootloaders.
# Nenhum passo precisa de privilégio.
#
# Modo genérico (padrão): o grub NÃO fixa IMAGEROOT — a sede é escolhida
# editando nutellaboot.conf na própria partição. Uma imagem serve todas as
# sedes, no lugar das ~45 imagens de 400 MB que só diferiam nesse token.

set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
DATA=${NB3_DATA_ROOT:-$REPO/data}
OUT=""
IMAGEROOT=""
FULLNAME=""
SERVER=""
BOOT_KEY="${NB3_BOOT_KEY:-}"
ADMIN_KEY="${NB3_ADMIN_KEY:-}"
HOSTS=()
WIFI=""
KERNEL="$REPO/client/build/vmlinuz"
INITRD="$REPO/client/build/initrd.img"
SIZE_MB=400
BIOS=1

usage() {
    cat << EOF
Uso: nb3-genusb [opções]

  -o, --output ARQUIVO     imagem de saída (padrão: maratonalinux-nb3.img)
      --imageroot ID       fixa a imagem no pendrive (padrão: genérico)
      --fullname NOME      nome de exibição da sede (aparece no menu do GRUB)
      --boot-key CHAVE     chave de boot da imagem (ou NB3_BOOT_KEY)
      --fetch-key          busca a chave de boot na API (usa --admin-key)
      --admin-key CHAVE    chave de administração (ou NB3_ADMIN_KEY)
      --server URL         servidor do NutellaBoot
      --hosts "nome=ip"    fixa nome no /etc/hosts do initrd (repetível)
      --wifi ARQUIVO       wifi.conf a embarcar
      --kernel ARQUIVO     vmlinuz (padrão: client/build/vmlinuz)
      --initrd ARQUIVO     initrd.img (padrão: client/build/initrd.img)
      --size MB            tamanho da imagem (padrão: 400)
      --no-bios            só EFI (dispensa o grub-mkimage i386-pc)
      --publish            envia a imagem pronta para o servidor de arquivos
EOF
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -o | --output) OUT=$2; shift 2 ;;
        --imageroot) IMAGEROOT=$2; shift 2 ;;
        --fullname) FULLNAME=$2; shift 2 ;;
        --boot-key) BOOT_KEY=$2; shift 2 ;;
        --admin-key) ADMIN_KEY=$2; shift 2 ;;
        --fetch-key) FETCH_KEY=1; shift ;;
        --server) SERVER=$2; shift 2 ;;
        --hosts) HOSTS+=("$2"); shift 2 ;;
        --wifi) WIFI=$2; shift 2 ;;
        --kernel) KERNEL=$2; shift 2 ;;
        --initrd) INITRD=$2; shift 2 ;;
        --size) SIZE_MB=$2; shift 2 ;;
        --no-bios) BIOS=0; shift ;;
        --publish) PUBLISH=1; shift ;;
        -h | --help) usage 0 ;;
        *) echo "opção desconhecida: $1" >&2; usage 1 ;;
    esac
done

OUT=${OUT:-maratonalinux-nb3.img}
FETCH_KEY=${FETCH_KEY:-0}
PUBLISH=${PUBLISH:-0}

# Busca a chave de boot da imagem na API, se pedido.
if [ "$FETCH_KEY" = 1 ]; then
    [ -n "$IMAGEROOT" ] || { echo "--fetch-key exige --imageroot" >&2; exit 1; }
    [ -n "$ADMIN_KEY" ] || { echo "--fetch-key exige --admin-key (ou NB3_ADMIN_KEY)" >&2; exit 1; }
    # sem padrao embutido: as irmas apontam para o ambiente de teste e esta
    # apontava para producao. Pendrive e coisa que se grava uma vez e some pela
    # sala — buscar a chave do servidor errado nao pode ser o comportamento
    # padrao de ninguem.
    API=${SERVER:-${NB3_BASE_URL:-}}
    [ -n "$API" ] || {
        echo "--fetch-key exige --server (ou NB3_BASE_URL): de qual servidor?" >&2
        exit 1
    }
    BOOT_KEY=$(curl -sS --fail "$API/api/v1/site-images/$IMAGEROOT/boot-key" \
        -H "Authorization: Bearer $ADMIN_KEY" |
        sed -n 's/.*"boot_key":"\([^"]*\)".*/\1/p')
    [ -n "$BOOT_KEY" ] || { echo "não consegui obter a chave de boot de $IMAGEROOT" >&2; exit 1; }
fi

# O nome de exibição sai do próprio registro da sede quando não vier na linha
# de comando. Exigir que o operador o digite de novo é como este recurso nasceu
# quebrado: quem gera o pendrive à mão não passa `--fullname`, e o menu do GRUB
# ficava sem o nome sem ninguém errar nada.
if [ -z "$FULLNAME" ] && [ -n "$IMAGEROOT" ] && [ -f "$DATA/site-images/$IMAGEROOT/image.json" ]; then
    FULLNAME=$(python3 -c '
import json, sys
print(json.load(open(sys.argv[1])).get("fullname", ""))
' "$DATA/site-images/$IMAGEROOT/image.json" 2> /dev/null || true)
fi

# mdir/truncate/dd tambem sao usados: sem conferir, o mdir so falha na ULTIMA
# linha do script, depois de a imagem inteira estar pronta
for t in sfdisk mformat mcopy mmd mdir truncate dd; do
    command -v "$t" > /dev/null || { echo "faltando: $t" >&2; exit 1; }
done

# As ferramentas do GRUB têm nomes diferentes por distribuição: `grub2-*` no
# Fedora, `grub-*` no Debian/Ubuntu. Este script nasceu numa máquina Fedora e
# por isso só funcionava lá — no servidor de produção (Ubuntu) a geração do
# pendrive falhava com "faltando: grub2-mkstandalone", e o botão da interface
# só dizia isso depois de a imagem inteira ter sido tentada.
acha_grub() {
    for n in "grub2-$1" "grub-$1"; do
        if command -v "$n" > /dev/null; then
            echo "$n"
            return 0
        fi
    done
    return 1
}
MKSTANDALONE=$(acha_grub mkstandalone) || {
    echo "faltando: grub2-mkstandalone/grub-mkstandalone (Ubuntu: grub-efi-amd64-bin)" >&2
    exit 1
}
if [ "$BIOS" = 1 ]; then
    MKIMAGE=$(acha_grub mkimage) || {
        echo "faltando: grub2-mkimage/grub-mkimage (Ubuntu: grub-pc-bin), ou use --no-bios" >&2
        exit 1
    }
fi
[ -f "$KERNEL" ] || { echo "kernel não encontrado: $KERNEL (rode nb3-build-initrd)" >&2; exit 1; }
[ -f "$INITRD" ] || { echo "initrd não encontrado: $INITRD (rode nb3-build-initrd)" >&2; exit 1; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# O nome de exibição vai para dentro de aspas que o GRUB vai reabrir no
# `source`. `$` é o pior: `set NB_SITE_NAME="R$ 10"` faz o source FALHAR
# inteiro, e com ele some o IMAGEROOT — o menu perde a sede por causa do nome.
# Acento fica: passa no grub-script-check e transliterar deixaria o nome errado
# na tela por medo de um problema que não existe.
# (mesma regra do servidor, em `services/usb.py:nome_para_grub`)
FULLNAME=$(printf '%s' "$FULLNAME" | tr -d '"$\\`' | tr -s '[:cntrl:][:space:]' ' ' |
    sed -e 's/^ *//' -e 's/ *$//')

# --- configuração da partição ---
{
    echo "# gerado por nb3-genusb — edite à vontade, é só texto"
    echo "# O initrd lê este arquivo, copia para a memória e desmonta a"
    echo "# partição já no início do boot: o pendrive pode ser retirado assim"
    echo "# que a mensagem aparecer na tela."
    echo "#"
    echo "# O 'set' na frente faz este mesmo arquivo servir ao menu do GRUB,"
    echo "# que so entende 'set VAR=valor'. O initrd aceita as duas formas."
    [ -n "$IMAGEROOT" ] && echo "set IMAGEROOT=\"$IMAGEROOT\"" || echo "#set IMAGEROOT=\"25brbr\""
    # só o menu do GRUB usa: o sistema recebe o mesmo nome pelo stuff.
    # `if` e não `[ ] && echo`: este script tem `set -e`, e a lista falha
    # quando o nome está vazio — abortaria a geração inteira
    if [ -n "$FULLNAME" ]; then
        echo "set NB_SITE_NAME=\"$FULLNAME\""
    fi
    if [ -n "$BOOT_KEY" ]; then
        echo "set NB_BOOT_KEY=\"$BOOT_KEY\""
    else
        echo "#set NB_BOOT_KEY=\"\"  # chave de boot (/api/v1/site-images/<id>/boot-key)"
    fi
    [ -n "$SERVER" ] && echo "set NB_SERVER=\"$SERVER\""
    for h in ${HOSTS+"${HOSTS[@]}"}; do
        echo "set NB_HOSTS=\"${h/=/ }\""
    done
} > "$WORK/nutellaboot.conf"

if [ -n "$WIFI" ]; then
    cp "$WIFI" "$WORK/wifi.conf"
else
    # Só os COMENTÁRIOS do exemplo. As três redes de exemplo têm senha de
    # aparência real (ICPC-BR/senha-da-rede-da-maratona), e esta imagem pode
    # acabar num diretório público do servidor de arquivos — embarcá-las por
    # padrão é publicar senha de exemplo com cara de senha de verdade.
    grep -E '^[[:space:]]*(#|$)' "$REPO/client/usb/wifi.conf.example" > "$WORK/wifi.conf" || true
    echo "# (sem redes: use --wifi ARQUIVO, ou edite este arquivo no pendrive)" >> "$WORK/wifi.conf"
fi

# --- grub.cfg (na partição, editável) ---
CMDLINE_BASE="boot=nutellaboot noresume pcie_aspm=off net.ifnames=0"
[ -n "$IMAGEROOT" ] && CMDLINE_BASE="$CMDLINE_BASE IMAGEROOT=$IMAGEROOT"

cat > "$WORK/grub.cfg" << EOF
set timeout=10
set default=0

# A sede sai do MESMO arquivo que o sistema lê. O nutellaboot.conf usa
# \`set CHAVE=valor\`, que é o que o GRUB entende — e o parser do initrd aceita
# o \`set\` como opcional, então pendrive antigo continua bootando. Num arquivo
# no formato antigo o \`source\` só não define nada, e o menu fica sem a sede.
if [ -f /nutellaboot.conf ]; then
	source /nutellaboot.conf
fi
# O nome de exibição entra quando o arquivo o traz; um pendrive editado à mão
# só com o IMAGEROOT continua mostrando o identificador, que é melhor que nada.
set nb3_sede=""
if [ -n "\$IMAGEROOT" ]; then
	set nb3_sede=" — \$IMAGEROOT"
	if [ -n "\$NB_SITE_NAME" ]; then
		set nb3_sede=" — \$NB_SITE_NAME (\$IMAGEROOT)"
	fi
fi

menuentry "Maratona Linux\$nb3_sede" {
	linux /vmlinuz $CMDLINE_BASE persistenthome=y
	initrd /initrd.img
}
menuentry "Maratona Linux\$nb3_sede — limpar a home (clean home)" {
	linux /vmlinuz $CMDLINE_BASE persistenthome=y cleanhome=y
	initrd /initrd.img
}
menuentry "Maratona Linux\$nb3_sede — modo live (sem home persistente)" {
	linux /vmlinuz $CMDLINE_BASE persistenthome=n
	initrd /initrd.img
}
menuentry "Remover o NutellaBoot deste computador (factory reset)" {
	linux /vmlinuz $CMDLINE_BASE factoryreset=y
	initrd /initrd.img
}
EOF

# grub embutido: só encontra a partição e carrega o grub.cfg de verdade,
# que fica editável na FAT. Busca pelo arquivo (mais confiável que por label,
# que depende de como o volume foi rotulado) e cai no label como reserva.
cat > "$WORK/grub-embed.cfg" << 'EOF'
insmod part_msdos
insmod fat
insmod search_fs_file
insmod search_label
search --no-floppy --file --set=root /nutellaboot.conf
if [ -z "$root" ]; then
	search --no-floppy --label --set=root NB3CFG
fi
# NÃO redefina prefix aqui: numa imagem standalone os módulos vivem no
# memdisk, e apontar o prefix para a partição faz o GRUB perder o acesso a
# eles (o menu carrega vazio, sem erro visível).
configfile ($root)/grub.cfg
EOF

echo ">> montando imagem de ${SIZE_MB}MB em $OUT"
rm -f "$OUT"
truncate -s "${SIZE_MB}M" "$OUT"

# Partição única FAT32 (tipo EF = EFI System), começando em 1 MiB: o espaço
# antes dela guarda o core.img do GRUB para BIOS legado.
sfdisk --quiet "$OUT" << EOF
label: dos
unit: sectors
start=2048, type=ef, bootable
EOF

OFFSET=$((2048 * 512))
mformat -i "$OUT@@$OFFSET" -F -v NB3CFG ::

echo ">> gerando bootloader EFI"
"$MKSTANDALONE" -O x86_64-efi \
    -o "$WORK/BOOTX64.EFI" \
    "boot/grub/grub.cfg=$WORK/grub-embed.cfg" 2>/dev/null

mmd -i "$OUT@@$OFFSET" ::/EFI ::/EFI/BOOT
mcopy -i "$OUT@@$OFFSET" "$WORK/BOOTX64.EFI" ::/EFI/BOOT/BOOTX64.EFI

if [ "$BIOS" = 1 ]; then
    echo ">> gerando bootloader BIOS legado"
    BOOTIMG=$(ls /usr/lib/grub/i386-pc/boot.img /usr/share/grub/i386-pc/boot.img 2>/dev/null | head -n1 || true)
    if [ -n "$BOOTIMG" ]; then
        # A mesma config embutida do EFI: acha a partição pelo label e carrega
        # o grub.cfg editável de lá — nada depende de número de disco.
        "$MKIMAGE" -O i386-pc -p "()/" -c "$WORK/grub-embed.cfg" -o "$WORK/core.img" \
            biosdisk part_msdos fat search search_label configfile normal linux echo test sleep
        # boot.img no setor 0 (preservando a tabela de partição) e core.img no
        # espaço livre entre a MBR e o início da partição (1 MiB).
        dd if="$BOOTIMG" of="$OUT" bs=446 count=1 conv=notrunc status=none
        dd if="$WORK/core.img" of="$OUT" bs=512 seek=1 conv=notrunc status=none
    else
        echo "   aviso: boot.img do GRUB não encontrado; imagem ficará só-EFI"
    fi
fi

echo ">> copiando kernel, initrd e configuração"
mcopy -i "$OUT@@$OFFSET" "$KERNEL" ::/vmlinuz
mcopy -i "$OUT@@$OFFSET" "$INITRD" ::/initrd.img
mcopy -i "$OUT@@$OFFSET" "$WORK/grub.cfg" ::/grub.cfg
mcopy -i "$OUT@@$OFFSET" "$WORK/nutellaboot.conf" ::/nutellaboot.conf
mcopy -i "$OUT@@$OFFSET" "$WORK/wifi.conf" ::/wifi.conf

if [ "$PUBLISH" = 1 ]; then
    echo ">> publicando no servidor de arquivos"
    # o arquivo precisa estar em data/usb para a API saber reenviar depois
    mkdir -p "$DATA/usb"
    [ "$(readlink -f "$OUT")" = "$(readlink -f "$DATA/usb/$(basename "$OUT")")" ] ||
        cp -f "$OUT" "$DATA/usb/"
    # publish_file() nunca levanta excecao (falha vira status: failed), entao
    # sem o sys.exit o SSH fora do ar imprimia "failed" no meio da saida e o
    # script terminava com "pronto:", como se tivesse publicado
    "$REPO/.venv/bin/python" -c "
import sys; sys.path.insert(0, '$REPO')
from server.app.services import publish
e = publish.publish_file('$DATA/usb/$(basename "$OUT")', 'usb')
print('   ', e['status'], e.get('url', e.get('error', '')))
if e.get('status') != 'done':
    sys.exit('publicacao falhou: ' + str(e.get('error', e)))
" || exit 1
fi

echo
echo "pronto: $OUT"
echo "  modo:      ${IMAGEROOT:-genérico (defina IMAGEROOT em nutellaboot.conf)}"
if [ -n "$FULLNAME" ]; then
    echo "  sede:      $FULLNAME"
elif [ -n "$IMAGEROOT" ]; then
    # dizer o que ficou de fora vale mais que o silêncio: foi assim que um
    # pendrive saiu sem o nome no menu sem nenhum sinal
    echo "  sede:      (sem nome de exibição; use --fullname para o menu mostrá-lo)"
fi
echo "  servidor:  ${SERVER:-padrão do initrd}"
echo "  gravar:    sudo dd if=$OUT of=/dev/sdX bs=4M status=progress oflag=sync"
echo "  conteúdo:"
mdir -i "$OUT@@$OFFSET" :: | sed 's/^/    /'
