#!/usr/bin/env python3
"""nb3-api — cliente de referência da API do NutellaBoot 3.

Feito para ser COPIADO. É um arquivo só, com biblioteca padrão do Python 3 e
nada mais: quem integra (MOJ, planilha da organização, script de sede) leva
este arquivo e usa, sem venv, sem pip, sem depender deste repositório.

    export NB3_BASE_URL=https://nutellaboot.naquadah.com.br
    export NB3_API_KEY=nb3a_...
    nb3-api whoami
    nb3-api bulk sedes.tsv > credenciais.csv

Três decisões que valem para quem for adaptar:

  * **TLS sempre verificado.** Não há opção de desligar, e não deve haver. O
    NutellaBoot 2 baixava tudo com a verificação desligada e ninguém sabia de
    onde vinha o sistema que rodava na prova.
  * **Falha alto.** Resposta fora de 2xx imprime o corpo no stderr e sai com
    código != 0. Isto não é zelo: o `nb3-gerar-squash` usava `curl -sS` sem
    `--fail`, um 404 devolvia JSON de erro com código de saída ZERO, e dois
    modelos ficaram vazios com o script dizendo que tinha registrado.
  * **Bearer, sempre.** O cookie de sessão é do navegador (e só vale com o
    cabeçalho `X-NB-Console`, que é o que barra CSRF). Ferramenta usa chave.

A mesma chave cobre três papéis, e o servidor decide o que cada uma pode:
`nb3a_` administração, `nb3s_` serviço com escopos, `nb3i_` o token de uma sede.
"""

from __future__ import annotations

import argparse
import csv
import io
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

TIMEOUT = 60


class ApiError(Exception):
    def __init__(self, status: int, body: str, url: str):
        super().__init__(f"HTTP {status} em {url}: {body}")
        self.status = status
        self.body = body


class Nb3:
    def __init__(self, base: str, key: str):
        self.base = base.rstrip("/")
        self.key = key

    def request(self, method: str, path: str, *, body=None, raw: bytes | None = None,
                content_type: str | None = None, params: dict | None = None):
        url = self.base + path
        if params:
            url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v not in (None, "")})
        dados = raw
        cabecalhos = {"Accept": "application/json"}
        if self.key:
            cabecalhos["Authorization"] = f"Bearer {self.key}"
        if body is not None:
            dados = json.dumps(body).encode()
            cabecalhos["Content-Type"] = "application/json"
        elif raw is not None and content_type:
            cabecalhos["Content-Type"] = content_type
        req = urllib.request.Request(url, data=dados, headers=cabecalhos, method=method)
        try:
            # sem `context=`: o padrão do Python já valida a cadeia e o nome.
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                texto = r.read().decode("utf-8", "replace")
                tipo = r.headers.get("Content-Type", "")
        except urllib.error.HTTPError as e:
            raise ApiError(e.code, e.read().decode("utf-8", "replace").strip(), url) from None
        except urllib.error.URLError as e:
            raise ApiError(0, f"não consegui falar com o servidor: {e.reason}", url) from None
        if not texto:
            return None
        if "json" in tipo:
            return json.loads(texto)
        return texto

    def get(self, path, **kw):
        return self.request("GET", path, **kw)

    def post(self, path, body=None, **kw):
        return self.request("POST", path, body=body, **kw)

    def put(self, path, body=None, **kw):
        return self.request("PUT", path, body=body, **kw)

    def delete(self, path, **kw):
        return self.request("DELETE", path, **kw)


# --- saída -------------------------------------------------------------------


def saida(valor, como_json: bool) -> None:
    if como_json or not isinstance(valor, (dict, list)):
        print(json.dumps(valor, ensure_ascii=False, indent=2) if como_json else valor)
        return
    if isinstance(valor, dict) and len(valor) == 1:
        (unico,) = valor.values()
        if isinstance(unico, list):
            valor = unico
    if isinstance(valor, list):
        for item in valor:
            if isinstance(item, dict):
                print("  ".join(f"{k}={item[k]}" for k in item if not isinstance(item[k], (dict, list))))
            else:
                print(item)
        return
    largura = max((len(k) for k in valor), default=0)
    for k, v in valor.items():
        print(f"{k.ljust(largura)}  {json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else v}")


def ler_corpo(arg: str):
    """`-` lê o stdin, `@arquivo` lê o arquivo, o resto é JSON literal."""
    if arg == "-":
        return json.loads(sys.stdin.read())
    if arg.startswith("@"):
        with open(arg[1:], encoding="utf-8") as f:
            return json.load(f)
    return json.loads(arg)


# --- comandos ----------------------------------------------------------------


def cmd_whoami(c, a):
    return c.get("/api/v1/whoami")


def cmd_images(c, a):
    if a.acao == "list":
        return c.get("/api/v1/site-images", params={"prefix": a.prefix})
    if a.acao == "get":
        return c.get(f"/api/v1/site-images/{a.image}")
    if a.acao == "create":
        return c.post(
            "/api/v1/site-images",
            {"id": a.image, "fullname": a.fullname or a.image, "model": a.model,
             "unlocked": a.unlocked},
        )
    if a.acao == "credentials":
        return c.get(f"/api/v1/site-images/{a.image}/credentials")
    if a.acao == "delete":
        c.delete(f"/api/v1/site-images/{a.image}")
        return {"deleted": a.image}
    raise SystemExit(f"ação desconhecida: {a.acao}")


def cmd_bulk(c, a):
    """Criação em massa — o caminho do começo de temporada.

    Sai em CSV com AS DUAS URLs da sede (configureitor e hotconfig): são os dois
    links que se entrega ao coordenador, e quem cria 50 sedes de uma vez não vai
    buscar o segundo de um em um.
    """
    with open(a.arquivo, "rb") as f:
        dados = f.read()
    if a.arquivo.endswith(".json"):
        resp = c.post("/api/v1/site-images/bulk", json.loads(dados.decode()))
        linhas = resp["results"]
    else:
        texto = c.request(
            "POST", "/api/v1/site-images/bulk",
            raw=dados, content_type="text/tab-separated-values",
            params={"format": "csv"},
        )
        if a.json:
            linhas = list(csv.DictReader(io.StringIO(texto)))
        else:
            sys.stdout.write(texto)
            return None
    if a.json:
        return linhas
    w = csv.writer(sys.stdout)
    colunas = ["id", "ok", "token", "machine_key", "boot_key",
               "configureitor_url", "hotconfig_url", "error"]
    w.writerow(colunas)
    for r in linhas:
        w.writerow([r.get(k, "") for k in colunas])
    return None


def cmd_config(c, a):
    if a.acao == "get":
        return c.get(f"/api/v1/site-images/{a.image}/config")
    return c.put(f"/api/v1/site-images/{a.image}/config", {"values": ler_corpo(a.valores)})


def cmd_roster(c, a):
    if a.acao == "get":
        return c.get(f"/api/v1/site-images/{a.image}/roster")
    corpo = ler_corpo(a.dados)
    if isinstance(corpo, list):
        corpo = {"roster": corpo}
    return c.put(f"/api/v1/site-images/{a.image}/roster", corpo)


def cmd_logo(c, a):
    with open(a.arquivo, "rb") as f:
        conteudo = f.read()
    tipo = "image/png" if a.arquivo.lower().endswith(".png") else "image/jpeg"
    return c.request(
        "PUT", f"/api/v1/site-images/{a.image}/roster/logos/{a.org}",
        raw=conteudo, content_type=tipo,
    )


def cmd_bindings(c, a):
    return c.get(f"/api/v1/site-images/{a.image}/bindings")


def cmd_bind(c, a):
    return c.put(
        f"/api/v1/site-images/{a.image}/machines/{a.mac}/binding",
        {"user_id": a.user_id, "seat": a.seat},
    )


def cmd_unbind(c, a):
    c.delete(f"/api/v1/site-images/{a.image}/machines/{a.mac}/binding")
    return {"unbound": a.mac}


def cmd_machines(c, a):
    if a.mac:
        return c.get(f"/api/v1/site-images/{a.image}/machines/{a.mac}")
    return c.get(f"/api/v1/site-images/{a.image}/machines")


def cmd_logs(c, a):
    return c.get(f"/api/v1/site-images/{a.image}/machines/{a.mac}/logs")


def cmd_alerts(c, a):
    return c.get(f"/api/v1/site-images/{a.image}/alerts")


def cmd_lock(c, a):
    if a.mac:
        return c.post(f"/api/v1/site-images/{a.image}/machines/{a.mac}/lock")
    return c.post(f"/api/v1/site-images/{a.image}/lock")


def cmd_unlock(c, a):
    if a.mac:
        return c.post(f"/api/v1/site-images/{a.image}/machines/{a.mac}/unlock")
    return c.post(f"/api/v1/site-images/{a.image}/unlock")


def cmd_command(c, a):
    corpo = {"command": a.command}
    if a.macs:
        corpo["macs"] = a.macs
    if a.args:
        corpo["args"] = ler_corpo(a.args)
    return c.post(f"/api/v1/site-images/{a.image}/commands", corpo)


def cmd_service_key(c, a):
    if a.acao == "list":
        return c.get("/api/v1/service-keys")
    if a.acao == "delete":
        c.delete(f"/api/v1/service-keys/{a.name}")
        return {"deleted": a.name}
    return c.post(
        "/api/v1/service-keys",
        {"name": a.name, "scopes": a.scopes or [], "images": a.images or []},
    )


def cmd_webhooks(c, a):
    if a.acao == "get":
        return c.get(f"/api/v1/site-images/{a.image}/webhooks")
    return c.put(f"/api/v1/site-images/{a.image}/webhooks", ler_corpo(a.dados))


def cmd_events(c, a):
    return c.get("/api/v1/events/types")


def cmd_report(c, a):
    return c.request(
        "GET", f"/api/v1/site-images/{a.image}/report",
        params={"since": a.since, "until": a.until, "lang": a.lang, "format": a.format},
    )


def cmd_usb(c, a):
    return c.request("GET", f"/api/v1/site-images/{a.image}/usb/conf")


# --- linha de comando --------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="nb3-api",
        description="Cliente de referência da API do NutellaBoot 3.",
        epilog="Credenciais: NB3_BASE_URL e NB3_API_KEY (ou --server/--key).",
    )
    p.add_argument("--server", default=os.environ.get("NB3_BASE_URL", ""))
    p.add_argument("--key", default=os.environ.get("NB3_API_KEY", os.environ.get("NB3_ADMIN_KEY", "")))
    p.add_argument("--json", action="store_true", help="saída JSON crua")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("whoami", help="o que esta chave pode").set_defaults(fn=cmd_whoami)

    s = sub.add_parser("images", help="sedes")
    s.add_argument("acao", choices=["list", "get", "create", "credentials", "delete"])
    s.add_argument("image", nargs="?", default="")
    s.add_argument("--prefix", default="")
    s.add_argument("--fullname", default="")
    s.add_argument("--model", default="")
    s.add_argument("--unlocked", action="store_true")
    s.set_defaults(fn=cmd_images)

    s = sub.add_parser("bulk", help="cria muitas sedes (TSV ou JSON) e devolve as duas URLs")
    s.add_argument("arquivo", help="id<TAB>nome[<TAB>modelo] por linha, ou .json")
    s.set_defaults(fn=cmd_bulk)

    s = sub.add_parser("config", help="formulário da sede")
    s.add_argument("acao", choices=["get", "set"])
    s.add_argument("image")
    s.add_argument("valores", nargs="?", default="{}", help='JSON, @arquivo ou -')
    s.set_defaults(fn=cmd_config)

    s = sub.add_parser("roster", help="times da sede")
    s.add_argument("acao", choices=["get", "set"])
    s.add_argument("image")
    s.add_argument("dados", nargs="?", default="[]", help="JSON, @arquivo ou -")
    s.set_defaults(fn=cmd_roster)

    s = sub.add_parser("logo", help="logotipo de uma instituição")
    s.add_argument("image")
    s.add_argument("org")
    s.add_argument("arquivo")
    s.set_defaults(fn=cmd_logo)

    s = sub.add_parser("bindings", help="vínculos máquina-time")
    s.add_argument("image")
    s.set_defaults(fn=cmd_bindings)

    s = sub.add_parser("bind", help="vincula uma máquina a um time")
    s.add_argument("image")
    s.add_argument("mac")
    s.add_argument("user_id")
    s.add_argument("--seat", default="")
    s.set_defaults(fn=cmd_bind)

    s = sub.add_parser("unbind")
    s.add_argument("image")
    s.add_argument("mac")
    s.set_defaults(fn=cmd_unbind)

    s = sub.add_parser("machines", help="telemetria")
    s.add_argument("image")
    s.add_argument("mac", nargs="?", default="")
    s.set_defaults(fn=cmd_machines)

    s = sub.add_parser("logs")
    s.add_argument("image")
    s.add_argument("mac")
    s.set_defaults(fn=cmd_logs)

    s = sub.add_parser("alerts", help="pendrive, celular, tethering")
    s.add_argument("image")
    s.set_defaults(fn=cmd_alerts)

    for nome, fn in (("lock", cmd_lock), ("unlock", cmd_unlock)):
        s = sub.add_parser(nome, help="a sala inteira, ou uma máquina")
        s.add_argument("image")
        s.add_argument("mac", nargs="?", default="")
        s.set_defaults(fn=fn)

    s = sub.add_parser("command", help="envia um comando à sala")
    s.add_argument("image")
    s.add_argument("command")
    s.add_argument("macs", nargs="*")
    s.add_argument("--args", default="", help="JSON, @arquivo ou -")
    s.set_defaults(fn=cmd_command)

    s = sub.add_parser("service-key", help="chave de integração, com escopos")
    s.add_argument("acao", choices=["create", "list", "delete"])
    s.add_argument("name", nargs="?", default="")
    s.add_argument("--scope", dest="scopes", action="append")
    s.add_argument("--image", dest="images", action="append")
    s.set_defaults(fn=cmd_service_key)

    s = sub.add_parser("webhooks")
    s.add_argument("acao", choices=["get", "set"])
    s.add_argument("image")
    s.add_argument("dados", nargs="?", default="{}", help="JSON, @arquivo ou -")
    s.set_defaults(fn=cmd_webhooks)

    sub.add_parser("events", help="catálogo de eventos e escopos").set_defaults(fn=cmd_events)

    s = sub.add_parser("report", help="relatório da sede por período (HTML)")
    s.add_argument("image")
    s.add_argument("since", help="epoch")
    s.add_argument("until", help="epoch")
    s.add_argument("--lang", default="pt")
    s.add_argument("--format", default="html", choices=["html", "json"])
    s.set_defaults(fn=cmd_report)

    s = sub.add_parser("usb", help="o nutellaboot.conf desta sede")
    s.add_argument("image")
    s.set_defaults(fn=cmd_usb)

    return p


def main(argv=None) -> int:
    a = build_parser().parse_args(argv)
    if not a.server:
        print("defina NB3_BASE_URL ou use --server", file=sys.stderr)
        return 2
    if not a.key:
        print("defina NB3_API_KEY ou use --key", file=sys.stderr)
        return 2
    try:
        resultado = a.fn(Nb3(a.server, a.key), a)
    except ApiError as e:
        # o corpo do erro é a explicação do servidor: engoli-lo é o que faz um
        # script dizer que deu certo quando não deu
        print(str(e), file=sys.stderr)
        return 1
    except (OSError, ValueError) as e:
        print(str(e), file=sys.stderr)
        return 1
    if resultado is not None:
        saida(resultado, a.json)
    return 0


if __name__ == "__main__":
    sys.exit(main())
