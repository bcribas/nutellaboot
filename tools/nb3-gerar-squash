#!/bin/bash
# nb3-gerar-squash — gera a camada base (o Maratona Linux inteiro) a partir da
# imagem-mestre, e registra no modelo.
#
# Substitui o mlinux/gerar-squash, que tinha o nome do .raw e o /mnt fixos no
# código, e cujo md5 era copiado do terminal para o servidor na mão.
#
# Com root, abre a imagem-mestre por losetup/mount. Sem root, pelo fuse2fs
# (e2fsprogs), com fakeroot para ler o que é só do root, e numa CÓPIA reflink
# da imagem: o fuse2fs grava o superbloco (hora e contador de montagem) mesmo
# com `-o ro`, e recusa montar o que não pode gravar. As duas dão a mesma
# camada: conferido em 2026-10-08 contra a base publicada (a mesma listagem de
# 282508 entradas, com dono, modo, tamanho e alvo de link, e as mesmas
# capabilities e xattrs).
#     tools/nb3-gerar-squash --raw ubuntu-24.04-initial.raw --name icpc-latam2026
#
# Com --register, registra a camada no modelo (aí precisa da chave de admin);
# com --publish, envia o arquivo para o servidor de arquivos antes:
#     sudo -E tools/nb3-gerar-squash --raw ... --name ... \
#         --register maratonalinux2604 --publish
#
# A camada entra com role=base, substituindo a base anterior do modelo. Casar
# por nome de arquivo não serve: o nome muda todo ano (icpc-latam2025 →
# maratonalinux2026) e o modelo ficaria com as duas — a máquina baixaria 13 GB
# e montaria duas raízes sobrepostas, sem erro nenhum.

set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
DATA=${NB3_DATA_ROOT:-$REPO/data}
RAW=""
NOME=""
PARTICAO=2
REGISTRAR=""
SERVIDOR=${NB3_BASE_URL:-}
CHAVE=${NB3_ADMIN_KEY:-}
SAIDA=""
PUBLICAR=0

usage() {
    cat << EOF
Uso: nb3-gerar-squash --raw IMAGEM.raw --name NOME [opções]

  --raw ARQUIVO      imagem-mestre do Maratona Linux
  --name NOME        nome da camada (vira <nome>.squash-<data>)
  --part N           partição raiz dentro do .raw (padrão: 2)
  --out DIR          onde gravar (padrão: data/blobs)
  --register MODELO  registra a camada neste modelo, como base
  --publish          envia o arquivo ao servidor de arquivos (files.mdp)
  --server URL       endereço da API (ou NB3_BASE_URL)
  --admin-key CHAVE  chave de administração (ou NB3_ADMIN_KEY)

Sem --publish a camada fica servida pela própria máquina de gestão. Para a
base isso significa a sala inteira baixando vários GB do mesmo servidor que
responde à API durante a prova.
EOF
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --raw) RAW=$2; shift 2 ;;
        --name) NOME=$2; shift 2 ;;
        --part) PARTICAO=$2; shift 2 ;;
        --out) SAIDA=$2; shift 2 ;;
        --register) REGISTRAR=$2; shift 2 ;;
        --publish) PUBLICAR=1; shift ;;
        --server) SERVIDOR=$2; shift 2 ;;
        --admin-key) CHAVE=$2; shift 2 ;;
        -h | --help) usage 0 ;;
        *) echo "opção desconhecida: $1" >&2; usage 1 ;;
    esac
done

[ -n "$RAW" ] && [ -n "$NOME" ] || usage 1
[ -f "$RAW" ] || { echo "imagem não encontrada: $RAW" >&2; exit 1; }
if [ "$(id -u)" != 0 ]; then
    command -v fuse2fs > /dev/null || {
        echo "sem root, a imagem-mestre abre pelo fuse2fs (pacote e2fsprogs/fuse2fs)" >&2
        exit 1
    }
fi

SAIDA=${SAIDA:-$DATA/blobs}
mkdir -p "$SAIDA"
ARQUIVO="$NOME.squash-$(date +%Y-%m-%d-%H-%M)"
MNT=$(mktemp -d)
LOOP=""
COPIA=""

cleanup() {
    if mountpoint -q "$MNT"; then
        if [ "$(id -u)" = 0 ]; then umount "$MNT"; else fusermount3 -u "$MNT" 2> /dev/null || fusermount -u "$MNT"; fi
    fi
    [ -n "$LOOP" ] && losetup -d "$LOOP" || true
    [ -n "$COPIA" ] && rm -f "$COPIA" || true
    rmdir "$MNT" 2> /dev/null || true
}
trap cleanup EXIT

echo ">> montando $RAW (partição $PARTICAO)"
if [ "$(id -u)" = 0 ]; then
    LOOP=$(losetup --show -r -fP "$RAW")
    mount -o ro,norecovery "${LOOP}p${PARTICAO}" "$MNT"
else
    # O fuse2fs grava o superbloco da imagem que monta, mesmo com `-o ro`: a
    # imagem-mestre não pode ser ela. A cópia reflink é instantânea e não gasta
    # espaço (btrfs, xfs); fica ao lado da original porque reflink não cruza
    # sistemas de arquivos. fakeroot deixa ler o /etc/shadow e afins; o dono e
    # o modo continuam os de verdade.
    SETOR=$(sfdisk -d "$RAW" | awk '/^sector-size:/ {print $2}')
    INICIO=$(partx -g -o START -n "$PARTICAO" "$RAW" | tr -d ' ')
    [ -n "$SETOR" ] && [ -n "$INICIO" ] || { echo "partição $PARTICAO não encontrada em $RAW" >&2; exit 1; }
    COPIA="$(dirname "$RAW")/.$(basename "$RAW").nb3-gerar-squash.$$"
    cp --reflink=always "$RAW" "$COPIA" 2> /dev/null || {
        echo "sem root, a imagem abre numa cópia reflink, e $(dirname "$RAW") não faz reflink" >&2
        echo "(precisa de btrfs ou xfs). Rode com sudo, ou mova a imagem." >&2
        exit 1
    }
    fuse2fs "$COPIA" "$MNT" -o "ro,norecovery,fakeroot,offset=$((INICIO * SETOR))"
fi

echo ">> gerando $ARQUIVO (pode demorar bastante)"
mksquashfs "$MNT" "$SAIDA/$ARQUIVO" \
    -comp zstd -Xcompression-level 15 -b 1048576 \
    -always-use-fragments -noappend \
    -e swapfile -e var/log -e root/sistema -e etc/nologin -e etc/fstab \
    -e boot -e lost+found -e usr/bin/grub-editenv \
    -e usr/share/doc/texlive-doc -e var/cache/backups -e home/icpc \
    -e var/cache/apt/pkgcache.bin -e var/cache/apt/srcpkgcache.bin \
    -e etc/.nb3 -e etc/.secrets -e etc/machine-id

MD5=$(md5sum "$SAIDA/$ARQUIVO" | cut -d' ' -f1)
TAMANHO=$(stat -c%s "$SAIDA/$ARQUIVO")
[ "$(id -u)" = 0 ] && chown "$(stat -c '%u:%g' "$REPO")" "$SAIDA/$ARQUIVO"

echo
echo "camada base pronta:"
echo "  arquivo: $SAIDA/$ARQUIVO"
echo "  md5:     $MD5"
echo "  tamanho: $((TAMANHO / 1024 / 1024)) MB"

URL_PUBLICA=""
if [ "$PUBLICAR" = 1 ]; then
    echo ">> publicando no servidor de arquivos (pode demorar: o arquivo tem GB)"
    URL_PUBLICA=$(PYTHONPATH="$REPO" python3 - "$SAIDA/$ARQUIVO" << 'PY'
import sys
from server.app.services import publish

if not publish.enabled():
    sys.exit("publicacao desligada em data/server.json (chave 'publish')")
estado = publish.publish_file(sys.argv[1])
if estado.get("status") != "done":
    sys.exit(f"publicacao falhou: {estado.get('error', estado)}")
print(estado["url"])
PY
    )
    echo "   $URL_PUBLICA"
fi

if [ -z "$REGISTRAR" ]; then
    echo
    if [ -z "$URL_PUBLICA" ]; then
        AVISO=" --publish"
        echo "AVISO: sem --publish, esta camada sera servida pela maquina de"
        echo "       gestao. Para a base isso e a sala inteira baixando GB do"
        echo "       mesmo servidor que responde a API durante a prova."
        echo
    else
        AVISO=""
    fi
    echo "para criar a temporada nova a partir da anterior (o caminho normal):"
    echo "  tools/nb3-nova-temporada --de <modelo anterior> --para <modelo novo> \\"
    echo "      --base $SAIDA/$ARQUIVO$AVISO"
    echo
    echo "ou para trocar a base de um modelo que ja existe:"
    echo "  $0 ... --register <modelo>$AVISO"
    exit 0
fi

[ -n "$SERVIDOR" ] && [ -n "$CHAVE" ] || {
    echo "informe --server e --admin-key para registrar" >&2
    exit 1
}

# Camada sem papel nao e reconhecida pelo replace_role: a base velha fica e o
# modelo termina com duas raizes, sem erro em lugar nenhum. Modelo importado do
# nb2 nasce assim.
ORFAS=$(curl -sS --fail-with-body "$SERVIDOR/api/v1/models/$REGISTRAR" \
    -H "Authorization: Bearer $CHAVE" |
    PYTHONPATH="$REPO" python3 -c '
import json, sys
from server.app.services import layer_roles
print(", ".join(layer_roles.sem_papel(json.load(sys.stdin).get("layers", []))))
') || {
    echo "erro: nao consegui ler o modelo '$REGISTRAR'." >&2
    echo "      confira o nome e a chave: curl \"$SERVIDOR/api/v1/models\"" >&2
    exit 1
}
if [ -n "$ORFAS" ]; then
    echo "erro: estas camadas de '$REGISTRAR' nao tem papel: $ORFAS" >&2
    echo "      a troca da base nao as reconhece e o modelo ficaria com duas" >&2
    echo "      raizes. Rode antes: tools/nb3-migrate-roles --dry-run" >&2
    exit 1
fi

echo ">> registrando como base do modelo $REGISTRAR"
# --fail-with-body: sem isto um 404 (nome de modelo errado) devolve o JSON de
# erro com codigo de saida ZERO, e o script terminava dizendo que deu certo
# sem ter registrado nada. Foi assim que dois modelos ficaram vazios.
CORPO=$(python3 -c '
import json, sys
md5, arquivo, tamanho, url = sys.argv[1:5]
camada = {"md5": md5, "file": arquivo, "size": int(tamanho),
          "role": "base", "replace_role": "base", "position": 99}
if url:
    camada["cdn_url"] = url
print(json.dumps(camada))
' "$MD5" "$ARQUIVO" "$TAMANHO" "$URL_PUBLICA")

curl -sS --fail-with-body -X POST "$SERVIDOR/api/v1/models/$REGISTRAR/layers" \
    -H "Authorization: Bearer $CHAVE" -H 'Content-Type: application/json' \
    --data "$CORPO" > /dev/null || {
    echo "erro: nao consegui registrar em '$REGISTRAR'." >&2
    echo "      confira o nome do modelo e a chave de admin:" >&2
    echo "      curl \"$SERVIDOR/api/v1/models\" -H \"Authorization: Bearer \$NB3_ADMIN_KEY\"" >&2
    exit 1
}

echo
echo ">> camadas de $REGISTRAR agora:"
curl -sS --fail-with-body "$SERVIDOR/api/v1/models/$REGISTRAR" \
    -H "Authorization: Bearer $CHAVE" |
    python3 -c '
import json, sys
for i, c in enumerate(json.load(sys.stdin)["layers"]):
    print(f"   {i}. {c[\"file\"]:46} {c.get(\"role\", \"extra\")}")
'
echo
echo "as maquinas pegam a base nova no proximo boot"
