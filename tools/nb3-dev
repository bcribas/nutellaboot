#!/bin/bash
# Sobe o servidor de desenvolvimento em 127.0.0.1:8890 (single-worker —
# invariante do long-poll/SSE; NUNCA use --workers >1).
#
# NÃO RECARREGA SOZINHO. Mudou código do servidor? Reinicie, ou suba com
# --reload:
#
#     tools/nb3-dev --reload
#
# Sem isso as ferramentas de linha de comando falam com a versão antiga da
# API e o sintoma é confuso: o teste passa (usa o código do disco) e o
# comando real se comporta como antes.
cd "$(dirname "$0")/.." || exit 1
exec .venv/bin/uvicorn server.app.main:app \
    --host "${NB3_HOST:-127.0.0.1}" \
    --port "${NB3_PORT:-8890}" \
    "$@"
